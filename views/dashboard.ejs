                                        <% stats.messagesByProperty.forEach(propGroup => { %>
                                            <option value="<%= propGroup.propertyId %>"><%= propGroup.propertyTitle %></option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="search-messages">
                                <input type="text" placeholder="Search messages..." class="search-input">
                                <button class="search-btn"><i class="fas fa-search"></i></button>
                            </div>
                        </div>

                        <!-- Messages List -->
                        <div class="messages-list">
                            <% if (messages && messages.length > 0) { %>
                                <% messages.forEach(message => { %>
                                    <div class="message-item <%= message.status %>" data-id="<%= message._id %>" data-property="<%= message.propertyId %>">
                                        <div class="message-info">
                                            <div class="sender">
                                                <h4 class="sender-name"><%= message.senderName %></h4>
                                                <p class="message-date"><%= new Date(message.createdAt).toLocaleDateString() %></p>
                                </div>
                                            <p class="message-property"><%= message.propertyTitle %></p>
                                            <p class="message-contact">
                                                <i class="fas fa-envelope"></i> <%= message.senderEmail %>
