                                                    <span class="separator">|</span> <i class="fas fa-phone"></i> <%= message.senderPhone %>
                                                <% } %>
                                            </p>
                                            <p class="message-preview"><%= message.message.substring(0, 100) %><%= message.message.length > 100 ? '...' : '' %></p>
                                </div>
                                <div class="message-actions">
                                            <button class="view-btn" data-id="<%= message._id %>"><i class="fas fa-eye"></i> View</button>
