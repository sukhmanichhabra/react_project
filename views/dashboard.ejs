<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.role === 'buyer' ? 'Buyer' : (user.role === 'agent' ? 'Agent' : (user.role === 'admin' ? 'Admin' : 'Seller')) %> Dashboard</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/advertised-properties.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="/assets/logo_main.png" alt="Logo" class="logo">
                <h2><%= user.role === 'buyer' ? 'Buyer' : (user.role === 'agent' ? 'Agent' : (user.role === 'admin' ? 'Admin' : 'Seller')) %> Dashboard</h2>
            </div>
            <nav class="sidebar-nav">
                <% if (user.role === 'buyer') { %>
                    <a href="#overview" class="nav-item active" data-section="overview">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#my-properties" class="nav-item" data-section="my-properties">
                        <i class="fas fa-building"></i>
                        <span>My Properties</span>
                    </a>
                    <a href="#rented-properties" class="nav-item" data-section="rented-properties">
                        <i class="fas fa-key"></i>
                        <span>My Rented Properties</span>
                    </a>
                    <a href="#profile" class="nav-item" data-section="profile">
                        <i class="fas fa-user"></i>
                        <span>Update Profile</span>
                    </a>
                <% } else if (user.role === 'agent') { %>
                    <a href="#overview" class="nav-item active" data-section="overview">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#managed-properties" class="nav-item" data-section="managed-properties">
                        <i class="fas fa-building"></i>
                        <span>Properties I Manage</span>
                    </a>
                    <a href="#verification" class="nav-item" data-section="verification">
                        <i class="fas fa-file-upload"></i>
                        <span>Upload Documents</span>
                    </a>
                    <a href="#messages" class="nav-item" data-section="messages">
                        <i class="fas fa-envelope"></i>
                        <span>Messages</span>
                    </a>
                    <a href="#profile" class="nav-item" data-section="profile">
                        <i class="fas fa-user"></i>
                        <span>Update Profile</span>
                    </a>
                <% } else if (user.role === 'admin') { %>
                    <a href="#overview" class="nav-item active" data-section="overview">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="#agent-verification" class="nav-item" data-section="agent-verification">
                        <i class="fas fa-user-check"></i>
                        <span>Agent Verification</span>
                    </a>
                    <a href="#manage-agents" class="nav-item" data-section="manage-agents">
                        <i class="fas fa-users-cog"></i>
                        <span>Manage Agents</span>
                    </a>
                    <a href="#loan-approval" class="nav-item" data-section="loan-approval">
                        <i class="fas fa-money-check-alt"></i>
                        <span>Loan Approval</span>
                    </a>
                    
                    <a href="#property-approval" class="nav-item" data-section="property-approval">
                        <i class="fas fa-home"></i>
                        <span>Property Approval</span>
                    </a>
                    
                    <a href="#profile" class="nav-item" data-section="profile">
                        <i class="fas fa-user-cog"></i>
                        <span>Admin Settings</span>
                    </a>
                <% } else { %>
                <a href="#overview" class="nav-item active" data-section="overview">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
                <a href="#add-listing" class="nav-item" data-section="add-listing">
                    <i class="fas fa-plus-circle"></i>
                    <span>Add Listing</span>
                </a>
                <a href="#my-properties" class="nav-item" data-section="my-properties">
                    <i class="fas fa-building"></i>
                    <span>My Properties</span>
                </a>
                <% if (user.role === 'seller') { %>
                <a href="#seller-rented-properties" class="nav-item" data-section="seller-rented-properties">
                    <i class="fas fa-key"></i>
                    <span>Rented Properties</span>
                </a>
                <% } %>
                <a href="#advertised-properties" class="nav-item" data-section="advertised-properties">
                    <i class="fas fa-ad"></i>
                    <span>Advertised Properties</span>
                </a>
                <a href="#transactions" class="nav-item" data-section="transactions">
                    <i class="fas fa-history"></i>
                    <span>Past Transactions</span>
                </a>
                <a href="#profile" class="nav-item" data-section="profile">
                    <i class="fas fa-user"></i>
                    <span>Update Profile</span>
                </a>
                <% } %>
                <button onclick="window.location.href='/'" class="nav-item">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back to Home</span>
                </button>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div class="top-bar-left">
                    <div class="welcome-message">
                        <h3>Welcome back, <%= user.name.split(' ')[0] %>!</h3>
                        <p class="current-date-time" id="currentDateTime"></p>
                    </div>
                </div>
                <div class="user-menu">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="profile-menu">
                        <img src="<%= user.profileImage || '/images/default-avatar.png' %>" alt="Profile" class="avatar">
                        <span class="username"><%= user.name %></span>
                    </div>
                </div>
            </div>

            <!-- Dashboard Content -->
            <div class="dashboard-content">
                <!-- Advertised Properties Section -->
                <section id="advertised-properties" class="dashboard-section advertised-properties">
                    <div class="section-header">
                        <h2>Advertised Properties</h2>
                        <p>Manage your property advertisements and track their performance</p>
                    </div>

                    <% if (advertisedProperties && advertisedProperties.length > 0) { %>
                        <div class="property-grid">
                            <% advertisedProperties.forEach(property => { %>
                                <div class="property-card">
                                    <div class="property-image">
                                        <img src="<%= property.images && property.images.length > 0 ? property.images[0] : '/assets/property-1.jpg' %>" alt="<%= property.title %>">
                                        <div class="advertising-badge">
                                            <i class="fas fa-ad"></i>
                                            <%= property.advertising.packageType === 'premium' ? 'Premium' : (property.advertising.packageType === 'featured' ? 'Featured' : 'Basic') %>
                                        </div>
                                    </div>
                                    <div class="property-details">
                                        <h3><%= property.title %></h3>
                                        <p class="property-location"><i class="fas fa-map-marker-alt"></i> <%= property.location %></p>
                                        <p class="property-price"><%= property.price.toLocaleString() %></p>
                                        <div class="property-features">
                                            <span><i class="fas fa-bed"></i> <%= property.features.beds %> Beds</span>
                                            <span><i class="fas fa-bath"></i> <%= property.features.baths %> Baths</span>
                                            <span><i class="fas fa-ruler-combined"></i> <%= property.features.sqft %> sqft</span>
                                        </div>
                                        <div class="advertising-details">
                                            <div class="package-info">
                                                <p>Package: <strong><%= property.advertising.packageType.charAt(0).toUpperCase() + property.advertising.packageType.slice(1) %></strong></p>
                                                <p>Expires: <%= new Date(property.advertising.endDate).toLocaleDateString() %></p>
                                            </div>
                                            <% 
                                            const now = new Date();
                                            const endDate = new Date(property.advertising.endDate);
                                            const startDate = new Date(property.advertising.startDate);
                                            
                                            // Ensure dates are valid
                                            const validStartDate = !isNaN(startDate.getTime()) ? startDate : now;
                                            const validEndDate = !isNaN(endDate.getTime()) ? endDate : new Date(now.getTime() + (30 * 24 * 60 * 60 * 1000));
                                            
                                            // Calculate total duration (should be 30 days = 2592000000 milliseconds)
                                            const totalDuration = validEndDate - validStartDate;
                                            
                                            // Calculate time elapsed and remaining
                                            const timeElapsed = now - validStartDate;
                                            const timeRemaining = validEndDate - now;
                                            
                                            // Calculate percentage remaining (ensure it's between 0-100)
                                            const percentRemaining = Math.max(0, Math.min(100, Math.round((timeRemaining / totalDuration) * 100)));
                                            
                                            // Calculate days remaining (round up for better UX)
                                            const daysRemaining = Math.max(0, Math.ceil(timeRemaining / (1000 * 60 * 60 * 24)));
                                            
                                            // Set width of progress bar based on percentage
                                            const progressWidth = `${percentRemaining}%`;
                                            
                                            // Determine color class based on percentage remaining
                                            let progressClass = '';
                                            if (percentRemaining > 66) {
                                                progressClass = 'progress-green';
                                            } else if (percentRemaining > 33) {
                                                progressClass = 'progress-yellow';
                                            } else {
                                                progressClass = 'progress-red';
                                            }
                                            %>
                                            <div class="time-remaining-container">
                                                <p class="time-remaining-text"><%= daysRemaining %> days remaining</p>
                                                <div class="time-remaining-bar">
                                                    <div class="time-remaining-progress <%= progressClass %>" data-width="<%= progressWidth %>"></div>
                                                </div>
                                            </div>
                                            <button class="cancel-package-btn" data-property-id="<%= property._id %>" data-advertising-id="<%= property.advertising._id %>">
                                                <i class="fas fa-times-circle"></i> Cancel Package
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-ad empty-icon"></i>
                            <h3>No Advertised Properties</h3>
                            <p>You don't have any properties with active advertising packages.</p>
                            <p>Visit the Advertising page to promote your properties and increase their visibility.</p>
                            <a href="/advertising" class="cta-button">Start Advertising</a>
                        </div>
                    <% } %>
                </section>

                <!-- Overview Section -->
                <section id="overview" class="dashboard-section active">
                    <!-- Stats Cards -->
                    <div class="stats-grid">
                        <!-- Account Balance Card - For All Users -->
                        <div class="stat-card balance-card">
                            <div class="stat-icon" style="background-color: #e0f7fa;">
                                <i class="fas fa-wallet" style="color: #0097a7;"></i>
                            </div>
                            <div class="stat-details">
                                <h3>Account Balance</h3>
                                <p class="stat-number balance-amount">$<%= user.accountBalance ? user.accountBalance.toLocaleString() : '0' %></p>
                                <% if (user.role === 'buyer') { %>
                                <a href="/add-funds" class="finance-action">
                                    <i class="fas fa-plus-circle"></i> Add Funds
                                </a>
                                <% } else if (user.role === 'seller') { %>
                                <a href="/add-funds" class="finance-action">
                                    <i class="fas fa-plus-circle"></i> Add Funds
                                </a>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="stat-card">
                            <div class="stat-icon" style="background-color: #e3f2fd;">
                                <i class="fas fa-home" style="color: #1976d2;"></i>
                            </div>
                            <div class="stat-details">
                                <h3>Active Listings</h3>
                                <p class="stat-number">12</p>
                                <span class="stat-trend positive">
                                    <i class="fas fa-arrow-up"></i> 8.3%
                                </span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background-color: #e8f5e9;">
                                <i class="fas fa-dollar-sign" style="color: #388e3c;"></i>
                            </div>
                            <div class="stat-details">
                                <h3>Total Sales</h3>
                                <p class="stat-number">$847,000</p>
                                <span class="stat-trend positive">
                                    <i class="fas fa-arrow-up"></i> 12.5%
                                </span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background-color: #fff3e0;">
                                <i class="fas fa-eye" style="color: #f57c00;"></i>
                            </div>
                            <div class="stat-details">
                                <h3>Total Views</h3>
                                <p class="stat-number">2,318</p>
                                <span class="stat-trend positive">
                                    <i class="fas fa-arrow-up"></i> 23.1%
                                </span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon" style="background-color: #fce4ec;">
                                <i class="fas fa-check-circle" style="color: #d81b60;"></i>
                            </div>
                            <div class="stat-details">
                                <h3>Completed Sales</h3>
                                <p class="stat-number">8</p>
                                <span class="stat-trend positive">
                                    <i class="fas fa-arrow-up"></i> 5.2%
                                </span>
                            </div>
                        </div>
                    </div>

                    <% if (user.role === 'buyer') { %>
                    <!-- Financial Overview Section -->
                    <div class="section-header">
                        <h2>Financial Overview</h2>
                        <p>Your account balance and loan status</p>
                    </div>
                    <div class="finance-overview">
                        <div class="finance-card balance-card">
                            <div class="finance-icon">
                                <i class="fas fa-wallet"></i>
                            </div>
                            <div class="finance-details">
                                <h3>Account Balance</h3>
                                <p class="balance-amount">$<%= user.accountBalance ? user.accountBalance.toLocaleString() : '0' %></p>
                                <a href="#" class="finance-action">Add Funds</a>
                            </div>
                        </div>
                        <div class="finance-card loan-card">
                            <div class="finance-icon">
                                <i class="fas fa-money-check-alt"></i>
                            </div>
                            <div class="finance-details">
                                <h3>Loan Status</h3>
                                <div class="loan-status-container">
                                    <% if (user.loanRequests && user.loanRequests.length > 0) { %>
                                        <p class="loan-status">Application in progress</p>
                                        <a href="/loan/my-applications" class="finance-action">View Details</a>
                                    <% } else { %>
                                        <p class="loan-status">No active loans</p>
                                        <a href="/loan/emi-calculator" class="finance-action">Apply for Loan</a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <% } %>

                    <!-- Charts Section -->
                    <div class="charts-section">
                        <div class="chart-container">
                            <h3>Sales Overview</h3>
                            <canvas id="salesChart"></canvas>
                        </div>
                        <div class="chart-container">
                            <h3>Property Views</h3>
                            <canvas id="viewsChart"></canvas>
                        </div>
                        <div class="chart-container">
                            <h3>Property Types</h3>
                            <canvas id="propertyTypesChart"></canvas>
                    </div>
                        <div class="chart-container">
                            <h3>Monthly Inquiries</h3>
                            <canvas id="inquiriesChart"></canvas>
                        </div>
                    </div>
                </section>

                <!-- Add Listing Section -->
                <section id="add-listing" class="dashboard-section">
                    <div class="section-header">
                        <h2>Add New Property Listing</h2>
                        <p>Fill in the details below to create a new property listing</p>
                    </div>
                    <div class="form-message" id="formMessage"></div>
                    <form action="/property/listing" method="POST" enctype="multipart/form-data" class="property-form" id="propertyForm">
                        <!-- Basic Information -->
                        <div class="form-section">
                            <h3>Basic Information</h3>
                            <div class="form-group">
                                <label for="title">Property Title</label>
                                <input type="text" id="title" name="title" required>
                                <div class="error-message" id="titleError"></div>
                                <div class="success-message" id="titleSuccess"></div>
                            </div>
                            <div class="form-group">
                                <label for="type">Property Type</label>
                                <select id="type" name="type" required>
                                    <option value="">Select Type</option>
                                    <option value="House">House</option>
                                    <option value="Apartment">Apartment</option>
                                    <option value="Villa">Villa</option>
                                    <option value="Cottage">Cottage</option>
                                    <option value="Loft">Loft</option>
                                    <option value="Studio">Studio</option>
                                </select>
                                <div class="error-message" id="typeError"></div>
                                <div class="success-message" id="typeSuccess"></div>
                            </div>
                            <div class="form-group">
                                <label for="tag">Listing Type</label>
                                <select id="tag" name="tag" required>
                                    <option value="">Select Type</option>
                                    <option value="sale">For Sale</option>
                                    <option value="rent">For Rent</option>
                                </select>
                                <div class="error-message" id="tagError"></div>
                                <div class="success-message" id="tagSuccess"></div>
                            </div>
                        </div>

                        <!-- Price Information -->
                        <div class="form-section">
                            <h3>Price Information</h3>
                            <div class="form-group">
                                <label for="price">Price</label>
                                <input type="number" id="price" name="price" required min="1000" step="100">
                                <div class="error-message" id="priceError"></div>
                                <div class="success-message" id="priceSuccess"></div>
                            </div>
                            <div class="form-group">
                                <label for="estPayment">Estimated Monthly Payment</label>
                                <input type="text" id="estPayment" name="estPayment" readonly>
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="form-section">
                            <h3>Location</h3>
                            <div class="form-group">
                                <label for="location">Full Address</label>
                                <input type="text" id="location" name="location" required>
                                <div class="error-message" id="locationError"></div>
                                <div class="success-message" id="locationSuccess"></div>
                            </div>
                        </div>

                        <!-- Features -->
                        <div class="form-section">
                            <h3>Features</h3>
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="sqft">Square Footage</label>
                                    <input type="number" id="sqft" name="sqft" required min="100" step="1">
                                    <div class="error-message" id="sqftError"></div>
                                    <div class="success-message" id="sqftSuccess"></div>
                                </div>
                                <div class="form-group">
                                    <label for="beds">Bedrooms</label>
                                    <input type="number" id="beds" name="beds" required min="0" max="20" step="1">
                                    <div class="error-message" id="bedsError"></div>
                                    <div class="success-message" id="bedsSuccess"></div>
                                </div>
                                <div class="form-group">
                                    <label for="baths">Bathrooms</label>
                                    <input type="number" id="baths" name="baths" required min="1" max="20" step="0.5">
                                    <div class="error-message" id="bathsError"></div>
                                    <div class="success-message" id="bathsSuccess"></div>
                                </div>
                                <div class="form-group">
                                    <label for="kitchen">Kitchens</label>
                                    <input type="number" id="kitchen" name="kitchen" required min="1" max="10" step="1">
                                    <div class="error-message" id="kitchenError"></div>
                                    <div class="success-message" id="kitchenSuccess"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Amenities -->
                        <div class="form-section">
                            <h3>Amenities</h3>
                            <div class="amenities-grid">
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="A/C & Heating">
                                    A/C & Heating
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Swimming Pool">
                                    Swimming Pool
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Garden">
                                    Garden
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Security">
                                    Security
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Parking">
                                    Parking
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Wifi">
                                    Wifi
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Pet Friendly">
                                    Pet Friendly
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Elevator">
                                    Elevator
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Fireplace">
                                    Fireplace
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Gym">
                                    Gym
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Play Ground">
                                    Play Ground
                                </label>
                                <label class="amenity-checkbox">
                                    <input type="checkbox" name="amenities" value="Disabled Access">
                                    Disabled Access
                                </label>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="form-section">
                            <h3>Description</h3>
                            <div class="form-group">
                                <label for="description">Property Description</label>
                                <textarea id="description" name="description" rows="5" required minlength="50" maxlength="2000" placeholder="Describe your property in detail (minimum 50 characters)"></textarea>
                                <div class="error-message" id="descriptionError"></div>
                                <div class="success-message" id="descriptionSuccess"></div>
                            </div>
                        </div>

                        <!-- Images -->
                        <div class="form-section">
                            <h3>Property Images</h3>
                            <div class="form-group">
                                <label for="images">Upload Images (Max 5)</label>
                                <input type="file" id="images" name="images" multiple accept="image/*" required>
                                <div class="error-message" id="imagesError"></div>
                                <div class="success-message" id="imagesSuccess"></div>
                            </div>
                            <div id="image-preview" class="image-preview-grid"></div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="submit-btn" id="submitBtn">List Property</button>
                            <button type="reset" class="reset-btn" id="resetBtn">Reset Form</button>
                        </div>
                    </form>
                </section>

                <!-- My Properties Section -->
                <section id="my-properties" class="dashboard-section">
                    <div class="section-header">
                        <h2>My Properties</h2>
                        <div class="section-actions">
                            <!-- <div class="filter-dropdown">
                                <select id="propertyFilter">
                                    <option value="all">All Properties</option>
                                    <option value="sale">For Sale</option>
                                    <option value="rent">For Rent</option>
                                </select>
                            </div> -->
                        </div>
                    </div>

                    <div class="properties-grid">
                        <% if (user.role === 'seller') { %>
                            <% 
                            let activeProperties = properties && properties.length > 0 ? properties.filter(property => property.status === 'active') : [];
                            let soldProperties = properties && properties.length > 0 ? properties.filter(property => property.status === 'sold') : [];
                            
                            if (activeProperties.length > 0) { 
                            %>
                                <% console.log('Rendering properties:', activeProperties.length); %>
                                <% activeProperties.forEach(property => { %>
                                    <% console.log('Rendering property:', property.id, property.title); %>
                                    <div class="property-card" data-type="<%= property.tag || 'sale' %>" data-id="<%= property.id %>">
                                    <div class="property-image">
                                        <img src="<%= property.images && property.images[0] ? property.images[0] : '/images/property-placeholder.jpg' %>" alt="<%= property.title %>">
                                        <div class="property-tag <%= property.tag === 'rent' ? 'rent' : 'sale' %>">
                                            <%= property.tag === 'rent' ? 'For Rent' : 'For Sale' %>
                                        </div>
                                        <div class="approval-status <%= property.approvalStatus %>">
                                            <% if (property.approvalStatus === 'pending') { %>
                                                <i class="fas fa-clock"></i> Pending Approval
                                            <% } else if (property.approvalStatus === 'approved') { %>
                                                <i class="fas fa-check-circle"></i> Approved
                                            <% } else if (property.approvalStatus === 'rejected') { %>
                                                <i class="fas fa-times-circle"></i> Rejected
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="property-details">
                                        <h3><%= property.title %></h3>
                                        <p class="property-location">
                                            <i class="fas fa-map-marker-alt"></i>
                                            <%= property.location %>
                                        </p>
                                        <div class="property-stats">
                                            <span><i class="fas fa-bed"></i> <%= property.features.beds %> Beds</span>
                                            <span><i class="fas fa-bath"></i> <%= property.features.baths %> Baths</span>
                                            <span><i class="fas fa-ruler-combined"></i> <%= property.features.sqft %> sqft</span>
                                        </div>
                                        <div class="property-price"><%= property.price %></div>
                                        <% if (property.approvalStatus === 'rejected' && property.adminNotes) { %>
                                        <div class="rejection-reason">
                                            <i class="fas fa-exclamation-circle"></i> Reason: <%= property.adminNotes %>
                                        </div>
                                        <% } %>
                                        <div class="property-actions">
                                            <a href="/property/<%= property.id %>" class="edit-btn">
                                                <i class="fas fa-view"></i> View
                                            </a>
                                            <button class="delete-btn" onclick="deleteProperty('<%= property.id %>')">
                                                <i class="fas fa-trash" style="color: white;"></i> <p style="color: white;">Delete</p>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                                <div class="no-properties" data-has-sold-properties="<%= soldProperties.length > 0 ? 'true' : 'false' %>">
                                <i class="fas fa-home"></i>
                                    <% if (soldProperties.length > 0) { %>
                                        <h3>All Properties Sold</h3>
                                        <p>Congratulations! All your properties have been sold. Would you like to add a new listing?</p>
                                    <% } else { %>
                                <h3>No Properties Found</h3>
                                <p>You haven't listed any properties yet.</p>
                                    <% } %>
                                    <a href="#add-listing" class="nav-item" data-section="add-listing">
                                        <i class="fas fa-plus-circle"></i> Add New Property
                                    </a>
                            </div>
                            <% } %>
                        <% } else if (user.role === 'buyer') { %>
                            <% if (properties && properties.length > 0) { %>
                                <% properties.forEach(property => { %>
                                    <div class="property-card" data-type="<%= property.tag || 'sale' %>" data-id="<%= property.id %>">
                                        <div class="property-image">
                                            <img src="<%= property.images && property.images[0] ? property.images[0] : '/images/property-placeholder.jpg' %>" alt="<%= property.title %>">
                                            <div class="property-tag <%= property.status === 'sold' ? 'sold' : (property.status === 'rented' ? 'rented' : (property.tag === 'rent' ? 'rent' : 'sale')) %>">
                                                <% if (property.status === 'sold') { %>
                                                    Purchased
                                                <% } else if (property.status === 'rented') { %>
                                                    Rented
                                                <% } else { %>
                                                    <%= property.tag === 'rent' ? 'For Rent' : 'For Sale' %>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="property-details">
                                            <h3><%= property.title %></h3>
                                            <p class="property-location">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <%= property.location %>
                                            </p>
                                            <div class="property-stats">
                                                <span><i class="fas fa-bed"></i> <%= property.features.beds %> Beds</span>
                                                <span><i class="fas fa-bath"></i> <%= property.features.baths %> Baths</span>
                                                <span><i class="fas fa-ruler-combined"></i> <%= property.features.sqft %> sqft</span>
                                            </div>
                                            <div class="property-price"><%= property.price %></div>
                                            <div class="property-actions">
                                                <a href="/property/<%= property.id %>" class="view-btn">
                                                    <i class="fas fa-eye"></i> View Details
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="no-properties">
                                    <i class="fas fa-home"></i>
                                    <h3>No Properties Found</h3>
                                    <p>You haven't purchased or rented any properties yet.</p>
                                    <a href="/property/list" class="browse-btn">
                                        <i class="fas fa-search"></i> Browse Properties
                                    </a>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </section>

                <!-- Buyer Rented Properties Section -->
                <section id="rented-properties" class="dashboard-section">
                    <div class="section-header">
                        <h2>My Rented Properties</h2>
                        <p>View and manage your rented properties</p>
                    </div>

                    <div class="properties-grid">
                        <% if (user.role === 'buyer') { %>
                            <% 
                            // Filter for only rented properties (status is 'rented' and tag is 'rent')
                            let rentedProperties = properties && properties.length > 0 ? 
                                properties.filter(property => property.status === 'rented' && property.tag === 'rent') : [];
                            
                            if (rentedProperties.length > 0) { 
                            %>
                                <% rentedProperties.forEach(property => { %>
                                    <div class="property-card rented-card" data-id="<%= property.id %>">
                                        <div class="property-image">
                                            <img src="<%= property.images && property.images[0] ? property.images[0] : '/images/property-placeholder.jpg' %>" alt="<%= property.title %>">
                                            <div class="property-tag rented">
                                                <i class="fas fa-key"></i> Rented
                                            </div>
                                        </div>
                                        <div class="property-details">
                                            <h3><%= property.title %></h3>
                                            <p class="property-location">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <%= property.location %>
                                            </p>
                                            <div class="property-stats">
                                                <span><i class="fas fa-bed"></i> <%= property.features.beds %> Beds</span>
                                                <span><i class="fas fa-bath"></i> <%= property.features.baths %> Baths</span>
                                                <span><i class="fas fa-ruler-combined"></i> <%= property.features.sqft %> sqft</span>
                                            </div>
                                            <div class="property-price">
                                                <i class="fas fa-rupee-sign"></i> <%= property.price %>/month
                                            </div>
                                            
                                            <div class="rental-info">
                                                <h4><i class="fas fa-info-circle"></i> Rental Information</h4>
                                                <p><strong>Rented On:</strong> <%= property.purchaseDate ? new Date(property.purchaseDate).toLocaleDateString() : 'Not available' %></p>
                                                <p><strong>Lease Duration:</strong> 12 months</p>
                                                <p><strong>Landlord:</strong> <%= property.seller && property.seller.name ? property.seller.name : 'Not available' %></p>
                                            </div>
                                            
                                            <div class="property-actions">
                                                <a href="/property/<%= property.id %>" class="view-btn">
                                                    <i class="fas fa-eye"></i> View Details
                                                </a>
                                                <button class="contact-landlord-btn" data-landlord-email="<%= property.seller ? property.seller.email : '' %>">
                                                    <i class="fas fa-envelope"></i> Contact Landlord
                                                </button>
                                                <button class="report-issue-btn" data-property-id="<%= property._id %>">
                                                    <i class="fas fa-exclamation-triangle"></i> Cancel Agreement
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="no-properties">
                                    <i class="fas fa-key empty-icon"></i>
                                    <h3>No Rented Properties Found</h3>
                                    <p>You haven't rented any properties yet.</p>
                                    <div class="no-properties-actions">
                                        <a href="/property/list?for=rent" class="add-property-btn">
                                            <i class="fas fa-search"></i> Browse Rental Properties
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </section>

                <!-- Rented Properties Section for Sellers -->
                <section id="seller-rented-properties" class="dashboard-section">
                    <div class="section-header">
                        <h2>Rented Properties</h2>
                        <p>Track your rental properties and manage tenant information</p>
                    </div>

                    <div class="properties-grid">
                        <% if (user.role === 'seller') { %>
                            <% 
                            // Filter for only rented properties (status is 'rented' and tag is 'rent')
                            let rentedProperties = properties && properties.length > 0 ? 
                                properties.filter(property => property.status === 'rented' && property.tag === 'rent') : [];
                            
                            if (rentedProperties.length > 0) { 
                            %>
                                <% rentedProperties.forEach(property => { %>
                                    <div class="property-card rented-card" data-id="<%= property.id %>">
                                        <div class="property-image">
                                            <img src="<%= property.images && property.images[0] ? property.images[0] : '/images/property-placeholder.jpg' %>" alt="<%= property.title %>">
                                            <div class="property-tag rented">
                                                <i class="fas fa-check-circle"></i> Rented
                                            </div>
                                        </div>
                                        <div class="property-details">
                                            <h3><%= property.title %></h3>
                                            <p class="property-location">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <%= property.location %>
                                            </p>
                                            <div class="property-stats">
                                                <span><i class="fas fa-bed"></i> <%= property.features.beds %> Beds</span>
                                                <span><i class="fas fa-bath"></i> <%= property.features.baths %> Baths</span>
                                                <span><i class="fas fa-ruler-combined"></i> <%= property.features.sqft %> sqft</span>
                                            </div>
                                            <div class="property-price"><%= property.price %></div>
                                            
                                            <div class="tenant-info">
                                                <h4><i class="fas fa-user"></i> Tenant Information</h4>
                                                <% if (property.buyer && property.buyer.name) { %>
                                                    <p><strong>Name:</strong> <%= property.buyer.name %></p>
                                                    <p><strong>Email:</strong> <%= property.buyer.email || 'Not available' %></p>
                                                    <p><strong>Phone:</strong> <%= property.buyer.phone || 'Not available' %></p>
                                                    <p><strong>Since:</strong> <%= property.purchaseDate ? new Date(property.purchaseDate).toLocaleDateString() : 'Not available' %></p>
                                                <% } else { %>
                                                    <p>Tenant information not available</p>
                                                <% } %>
                                            </div>
                                            
                                            <div class="property-actions">
                                                <a href="/property/<%= property.id %>" class="view-btn">
                                                    <i class="fas fa-eye"></i> View Details
                                                </a>
                                                <button class="contact-tenant-btn" data-tenant-email="<%= property.buyer ? property.buyer.email : '' %>">
                                                    <i class="fas fa-envelope"></i> Contact Tenant
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="no-properties">
                                    <i class="fas fa-key empty-icon"></i>
                                    <h3>No Rented Properties Found</h3>
                                    <p>You don't have any properties that are currently rented out.</p>
                                    <div class="no-properties-actions">
                                        <a href="#add-listing" class="nav-item add-property-btn" data-section="add-listing">
                                            <i class="fas fa-plus-circle"></i> List a Rental Property
                                        </a>
                                        <a href="#my-properties" class="nav-item back-btn" data-section="my-properties">
                                            <i class="fas fa-arrow-left"></i> Back to My Properties
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                    </div>
                </section>

                <!-- Transactions Section -->
                <section id="transactions" class="dashboard-section">
                    <div class="section-header">
                        <h2>Past Transactions</h2>
                        <a href="/property/my-transactions" class="view-all-btn">View All Transactions</a>
                    </div>
                    <div class="transactions-list">
                        <% if (stats && stats.totalTransactions > 0 && transactions && transactions.length > 0) { %>
                            <table class="transactions-table">
                                <thead>
                                    <tr>
                                        <th>Property</th>
                                        <th>Buyer</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <!-- <th>Status</th> -->
                                    </tr>
                                </thead>
                                <tbody>
                                    <% transactions.slice(0, 3).forEach(transaction => { %>
                                        <tr>
                                            <td>
                                                <div class="property-info">
                                                    <img src="<%= transaction.propertyImage %>" alt="<%= transaction.propertyTitle %>">
                                                    <span><%= transaction.propertyTitle %></span>
                                                </div>
                                            </td>
                                            <td><%= transaction.buyerName %></td>
                                            <td><%= new Date(transaction.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                                            <td><%= transaction.amount %></td>
                                            <!-- <td><span class="status-badge <%= transaction.status.toLowerCase() %>"><%= transaction.status %></span></td> -->
                                        </tr>
                                    <% }); %>
                                    <% if (transactions.length > 3) { %>
                                        <tr>
                                            <td colspan="5" class="text-center">
                                                <a href="/property/my-transactions" class="view-more-link">
                                                    <i class="fas fa-ellipsis-h"></i> View <%= transactions.length - 3 %> more transactions
                                                </a>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        <% } else { %>
                            <div class="no-transactions">
                                <i class="fas fa-receipt"></i>
                                <h3>No Transactions Found</h3>
                                <p>You haven't completed any property transactions yet.</p>
                            </div>
                        <% } %>
                    </div>
                </section>

                <!-- Profile Section -->
                <section id="profile" class="dashboard-section">
                    <div class="section-header">
                        <h2>Update Profile</h2>
                    </div>
                    <div class="profile-container">
                        <form class="profile-form" action="/dashboard/update-profile" method="POST" enctype="multipart/form-data" id="profileForm">
                            <div class="profile-header">
                                <div class="profile-avatar">
                                    <img src="<%= user.profileImage || '/images/default-avatar.png' %>" alt="Profile" id="profile-preview">
                                    <label for="profileImage" class="change-avatar">
                                        <i class="fas fa-camera"></i>
                                    </label>
                                    <input type="file" id="profileImage" name="profileImage" accept="image/*" style="display: none;">
                                </div>
                                <div class="profile-info">
                                    <h3><%= user.name %></h3>
                                    <p><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %> since <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></p>
                                    <% if (user.role === 'agent' && agentProfile) { %>
                                    <span class="verification-badge <%= agentProfile.verified ? 'verified' : 'unverified' %>">
                                        <i class="fas <%= agentProfile.verified ? 'fa-check-circle' : 'fa-clock' %>"></i>
                                        <%= agentProfile.verified ? 'Verified Agent' : 'Pending Verification' %>
                                    </span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="name">Full Name</label>
                                    <input type="text" id="name" name="name" value="<%= user.name || '' %>" required>
                                </div>
                                <!-- <div class="form-group">
                                    <label for="email">Email</label>
                                    <input type="email" id="email" name="email" value="<%= user.email || '' %>" required>
                                </div> -->
                                <div class="form-group">
                                    <label for="phone">Phone</label>
                                    <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>">
                                </div>
                                <div class="form-group">
                                    <label for="location">Location</label>
                                    <input type="text" id="location" name="location" value="<%= user.location || '' %>">
                                </div>
                                
                                <% if (user.role === 'agent') { %>
                                <div class="form-group">
                                    <label for="title">Professional Title</label>
                                    <input type="text" id="title" name="title" value="<%= agentProfile ? agentProfile.title : 'Real Estate Agent' %>" placeholder="Real Estate Agent">
                                </div>
                                <div class="form-group">
                                    <label for="qualification">Qualifications</label>
                                    <input type="text" id="qualification" name="qualification" value="<%= agentProfile ? agentProfile.qualification : '' %>" placeholder="e.g., Licensed Realtor, MBA in Real Estate">
                                </div>
                                <% } %>
                                
                                <div class="form-group">
                                    <label for="website">Website</label>
                                    <input type="url" id="website" name="website" value="<%= user.website || '' %>" placeholder="https://example.com">
                                </div>
                                
                                <% if (user.role === 'agent') { %>
                                <div class="form-group full-width">
                                    <label for="overview">Professional Overview</label>
                                    <textarea id="overview" name="overview" rows="6" placeholder="Describe your experience, expertise, and approach to real estate..."><%= agentProfile ? agentProfile.overview : '' %></textarea>
                                    <p class="hint-text">This detailed overview will appear on your public agent profile.</p>
                                </div>
                                <% } %>
                                
                                <div class="form-group full-width">
                                    <label for="bio">Bio</label>
                                    <textarea id="bio" name="bio" rows="4" placeholder="Tell us a bit about yourself..."><%= user.bio || '' %></textarea>
                                </div>
                            </div>
                            
                            <div class="social-links-section">
                                <h3>Social Media Links</h3>
                                <div class="social-links-grid">
                                    <div class="form-group">
                                        <label for="facebook"><i class="fab fa-facebook"></i> Facebook</label>
                                        <input type="url" id="facebook" name="facebook" value="<%= user.socialLinks && user.socialLinks.facebook ? user.socialLinks.facebook : '' %>" placeholder="https://facebook.com/username">
                                    </div>
                                    <div class="form-group">
                                        <label for="twitter"><i class="fab fa-twitter"></i> Twitter</label>
                                        <input type="url" id="twitter" name="twitter" value="<%= user.socialLinks && user.socialLinks.twitter ? user.socialLinks.twitter : '' %>" placeholder="https://twitter.com/username">
                                    </div>
                                    <div class="form-group">
                                        <label for="instagram"><i class="fab fa-instagram"></i> Instagram</label>
                                        <input type="url" id="instagram" name="instagram" value="<%= user.socialLinks && user.socialLinks.instagram ? user.socialLinks.instagram : '' %>" placeholder="https://instagram.com/username">
                                    </div>
                                    <div class="form-group">
                                        <label for="linkedin"><i class="fab fa-linkedin"></i> LinkedIn</label>
                                        <input type="url" id="linkedin" name="linkedin" value="<%= user.socialLinks && user.socialLinks.linkedin ? user.socialLinks.linkedin : '' %>" placeholder="https://linkedin.com/in/username">
                                    </div>
                                    <% if (user.role === 'agent') { %>
                                    <!-- WhatsApp and Viber inputs removed -->
                                    <% } %>
                                </div>
                            </div>
                            
                            <div class="form-actions">
                                <button type="submit" class="submit-btn">Save Changes</button>
                                <button type="reset" class="reset-btn">Reset Form</button>
                            </div>
                        </form>
                    </div>
                </section>

                <!-- Agent: Properties I Manage Section -->
                <section id="managed-properties" class="dashboard-section">
                    <div class="section-header">
                        <h2>Properties I Manage</h2>
                        <div class="section-actions">
                            <div class="filter-dropdown">
                                <select id="propertyStatusFilter">
                                    <option value="all">All Properties</option>
                                    <option value="active">Active</option>
                                    <option value="sold">Sold</option>
                                    <option value="rented">Rented</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="properties-grid">
                        <% if (properties && properties.length > 0) { %>
                            <% properties.forEach(property => { %>
                                <div class="property-card" data-type="<%= property.tag %>" data-status="<%= property.status || 'active' %>">
                            <div class="property-image">
                                        <img src="<%= property.images && property.images.length > 0 ? property.images[0] : '/assets/property-placeholder.jpg' %>" alt="<%= property.title %>">
                                        <div class="property-tag <%= property.status === 'sold' ? 'sold' : (property.status === 'rented' ? 'rented' : (property.tag === 'rent' ? 'rent' : 'sale')) %>">
                                            <%= property.status === 'sold' ? 'Sold' : (property.status === 'rented' ? 'Rented' : (property.tag === 'rent' ? 'For Rent' : 'For Sale')) %>
                            </div>
                            </div>
                            <div class="property-details">
                                        <h3><%= property.title %></h3>
                                <p class="property-location">
                                    <i class="fas fa-map-marker-alt"></i>
                                            <%= property.location %>
                                </p>
                                <div class="property-stats">
                                            <span><i class="fas fa-bed"></i> <%= property.bedrooms %> Beds</span>
                                            <span><i class="fas fa-bath"></i> <%= property.bathrooms %> Baths</span>
                                            <span><i class="fas fa-ruler-combined"></i> <%= property.area %> sqft</span>
                                </div>
                                        <div class="property-price">
                                            <%= property.price %><%= property.tag === 'rent' ? '' : '' %>
                                </div>
                                <div class="property-actions">
                                            <a href="/property/<%= property.id %>" class="view-btn">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                            <% }) %>
                        <% } else { %>
                            <div class="no-properties-message">
                                <p>You don't have any properties assigned to manage yet.</p>
                                <p>Properties will be assigned to you by the system administrator.</p>
                            </div>
                        <% } %>
                    </div>

                    
                </section>

                <!-- Update the verification section to display dynamic status -->
                <section id="verification" class="dashboard-section">
                    <div class="verification-container">
                        <div class="section-title">
                            <h3>Agent Verification</h3>
                            <p>Submit required documents to verify your agent account</p>
                    </div>

                        <% 
                        let statusClass = 'pending';
                        let statusText = 'Pending Verification';
                        let statusMessage = 'Your documents are being reviewed. This process typically takes 1-2 business days.';
                        
                        if (agentProfile && agentProfile.verificationStatus) {
                            if (agentProfile.verificationStatus === 'verified') {
                                statusClass = 'verified';
                                statusText = 'Verified';
                                statusMessage = 'Your agent account has been verified. You can now access all agent features.';
                            } else if (agentProfile.verificationStatus === 'rejected') {
                                statusClass = 'rejected';
                                statusText = 'Verification Failed';
                                statusMessage = agentProfile.verificationMessage || 'Your verification was unsuccessful. Please upload new documents.';
                            } else {
                                statusMessage = agentProfile.verificationMessage || statusMessage;
                            }
                        }

                        // Check if agent profile is complete
                        let isProfileComplete = false;
                        let missingFields = [];

                        if (agentProfile) {
                            // Check required fields
                            if (!agentProfile.name) missingFields.push('Name');
                            if (!agentProfile.title) missingFields.push('Professional Title');
                            if (!agentProfile.phone) missingFields.push('Phone Number');
                            if (!agentProfile.location) missingFields.push('Location');
                            if (!agentProfile.qualification) missingFields.push('Qualifications');
                            if (!agentProfile.overview || agentProfile.overview.length < 50) missingFields.push('Professional Overview');
                            
                            isProfileComplete = missingFields.length === 0;
                        }
                        %>

                        <div class="status-card <%= statusClass %>">
                                <div class="status-icon">
                                <% if (statusClass === 'verified') { %>
                                    <i class="fas fa-check-circle"></i>
                                <% } else if (statusClass === 'rejected') { %>
                                    <i class="fas fa-times-circle"></i>
                                <% } else { %>
                                    <i class="fas fa-clock"></i>
                                <% } %>
                                </div>
                            <div class="status-info">
                                <h4><%= statusText %></h4>
                                <p><%= statusMessage %></p>
                                </div>
                            </div>

                        <% if (!isProfileComplete && statusClass !== 'verified') { %>
                            <div class="incomplete-profile-alert">
