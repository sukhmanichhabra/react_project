<!-- Announcement bar script -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Mobile menu functionality
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const closeMenu = document.getElementById('closeMenu');
        const toggleSubmenu = document.querySelectorAll('.toggle-submenu');

        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', function() {
                mobileMenu.classList.add('active');
                document.body.style.overflow = 'hidden';
            });
        }

        if (closeMenu) {
            closeMenu.addEventListener('click', function() {
                mobileMenu.classList.remove('active');
                document.body.style.overflow = 'auto';
            });
        }

        toggleSubmenu.forEach(function(button) {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const submenuId = this.getAttribute('data-submenu') + '-submenu';
                const submenu = document.getElementById(submenuId);
                
                if (submenu.style.display === 'block') {
                    submenu.style.display = 'none';
                    this.querySelector('i').classList.remove('fa-chevron-up');
                    this.querySelector('i').classList.add('fa-chevron-down');
                } else {
                    // Close all other submenus
                    document.querySelectorAll('.mobile-submenu').forEach(function(menu) {
                        menu.style.display = 'none';
                    });
                    
                    // Reset all icons
                    document.querySelectorAll('.toggle-submenu i').forEach(function(icon) {
                        icon.classList.remove('fa-chevron-up');
                        icon.classList.add('fa-chevron-down');
                    });
                    
                    submenu.style.display = 'block';
                    this.querySelector('i').classList.remove('fa-chevron-down');
                    this.querySelector('i').classList.add('fa-chevron-up');
                }
            });
        });
        
        // Announcement bar animation - only run if the announcement bar exists
        const announcementText = document.querySelector('.announcement-text');
        if (announcementText) {
            // Clone the announcements for seamless scrolling
            announcementText.innerHTML += announcementText.innerHTML;
            
            // Set initial position
            let scrollPosition = 0;
            
            // Scroll animation
            function scrollAnnouncement() {
                scrollPosition++;
                // Reset position when all items have scrolled
                if (scrollPosition >= announcementText.scrollWidth / 2) {
                    scrollPosition = 0;
                }
                announcementText.style.transform = `translateX(-${scrollPosition}px)`;
                requestAnimationFrame(scrollAnnouncement);
            }
            
            scrollAnnouncement();
        }
    });
</script>

<style>
    .announcement-bar {
        background: linear-gradient(90deg, #FF8C00, #FFA500);
        color: white;
        padding: 8px 0;
        font-size: 14px;
        position: relative;
        overflow: hidden;
        width: 100%;
    }
    
    .announcement-content {
        width: 100%;
        overflow: hidden;
    }
    
    .announcement-text {
        white-space: nowrap;
        display: inline-block;
    }
    
    .announcement-text span {
        display: inline-block;
        padding: 0 30px;
    }
    
    /* Adjust navbar top margin to compensate for announcement bar */
    .navbar {
        margin-top: 15px;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
        .announcement-bar {
            font-size: 12px;
            padding: 6px 0;
        }
        
        .navbar {
            margin-top: 10px;
        }
    }
</style>

<% if (locals.user && locals.user.role === 'buyer') { %>
<script>
    // Check if user has any approved loans to show the Pay EMI link
    document.addEventListener('DOMContentLoaded', async function() {
        try {
            const response = await fetch('/loan/has-approved-loans');
            const data = await response.json();
            
            if (data.success && data.hasApprovedLoans) {
                // Show the Pay EMI links if user has approved loans
                const desktopLink = document.getElementById('payEmiLink');
                const mobileLink = document.getElementById('payEmiLinkMobile');
                
                if (desktopLink) desktopLink.style.display = 'block';
                if (mobileLink) mobileLink.style.display = 'block';
            }
        } catch (error) {
            console.error('Error checking loan status:', error);
        }
    });
</script>
<% } %>