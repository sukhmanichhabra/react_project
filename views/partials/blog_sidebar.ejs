<!-- Category Section -->
<div class="category-section">
    <h2>Category</h2>
    <ul class="category-list">
        <li><a href="/blog_list" class="<%= !activeTag ? 'active' : '' %>">
            All <span>(<%= Object.values(tagCounts).reduce((a, b) => a + b, 0) %>)</span>
        </a></li>
        <li><a href="/blog_list?tag=residential" class="<%= activeTag === 'residential' ? 'active' : '' %>">
            Residential <span>(<%= tagCounts.residential || 0 %>)</span>
        </a></li>
        <li><a href="/blog_list?tag=commercial" class="<%= activeTag === 'commercial' ? 'active' : '' %>">
            Commercial <span>(<%= tagCounts.commercial || 0 %>)</span>
        </a></li>
        <li><a href="/blog_list?tag=investment" class="<%= activeTag === 'investment' ? 'active' : '' %>">
            Investment <span>(<%= tagCounts.investment || 0 %>)</span>
        </a></li>
        <li><a href="/blog_list?tag=market-trends" class="<%= activeTag === 'market-trends' ? 'active' : '' %>">
            Market Trends <span>(<%= tagCounts['market-trends'] || 0 %>)</span>
        </a></li>
    </ul>
</div>

<style>
.category-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.category-list li {
    margin-bottom: 10px;
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
}

.category-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #333;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
}

.category-list a:hover {
    color: #ff8800;
}

.category-list a.active {
    color: #ff8800;
    font-weight: 600;
}

.category-list span {
    background-color: #f5f5f5;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.9em;
    color: #666;
}

.category-list a:hover span,
.category-list a.active span {
    background-color: #ff8800;
    color: white;
}
</style> 