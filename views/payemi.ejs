                                                                </table>
                                                                <% } %>
                                                                    <% }); %>
                                                                        <% } else { %>
                                                                            <div class="empty-state">
                                                                                <% if (locals.loanSummaries &&
                                                                                    loanSummaries.some(loan=>
                                                                                    loan.pendingEmiCount === 0 &&
                                                                                    loan.paidEmiCount > 0)) { %>
                                                                                    <i class="fas fa-history"
                                                                                        style="color: #2e7d32;"></i>
                                                                                    <h3>Loan Successfully Paid Off</h3>
                                                                                    <p>You have successfully completed
                                                                                        all your EMI payments. View your
                                                                                        payment history by selecting a
                                                                                        loan above.</p>
                                                                                    <% } else { %>
                                                                                        <i class="fas fa-history"></i>
                                                                                        <h3>No Payment History</h3>
                                                                                        <p>You haven't made any EMI
                                                                                            payments yet.</p>
                                                                                        <% } %>
                                                                            </div>
                                                                            <% } %>
