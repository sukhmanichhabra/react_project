                                                                                            + payment.status.slice(1) %>
                                                                                    </span>
                                                                                    <button class="invoice-btn"
                                                                                        data-payment-id="<%= payment._id %>"
                                                                                        data-emi-number="<%= payment.emiNumber || 1 %>"
                                                                                        data-amount="<%= payment.amount %>"
                                                                                        data-principal="<%= payment.principalAmount || 0 %>"
                                                                                        data-interest="<%= payment.interestAmount || 0 %>"
