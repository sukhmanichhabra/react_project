<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="shortcut icon" href="./assets/favicon.svg" type="image/svg+xml">

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/payemi.css">
</head>

<body>
    <%- include('./partials/header') %>

        <div class="container">
            <div class="page-header">
                <h1 class="page-title">EMI Payments</h1>
            </div>

            <% if (locals.message) { %>
                <div class="alert-message">
                    <p>
                        <%= message %>
                    </p>
                </div>
                <% } %>

                    <% if (locals.loanSummaries && loanSummaries.some(loan=> loan.pendingEmiCount === 0 &&
                        loan.paidEmiCount > 0)) { %>
                        <div class="alert-message"
                            style="background-color: #e8f5e9; color: #2e7d32; border-left-color: #2e7d32;">
                            <p><i class="fas fa-check-circle"></i> Congratulations! You have fully paid off your loan.
                                Your commitment and timely payments have helped you achieve financial freedom.</p>
                        </div>
                        <% } %>

                            <% if (locals.emiSummary && emiPayments && emiPayments.length> 0) { %>
                                <!-- EMI Dashboard -->
                                <div class="dashboard-section">
                                    <div class="dashboard-header">
                                        <h2>Payment Dashboard</h2>
                                    </div>
                                    <div class="dashboard-cards">
                                        <div class="dashboard-card">
                                            <div class="card-icon">
                                                <i class="fas fa-wallet"></i>
                                            </div>
                                            <div class="card-content">
                                                <h3 class="card-title">Total Paid</h3>
                                                <p class="card-value">₹<%= (emiSummary.paidAmount ||
                                                        0).toLocaleString('en-IN') %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="dashboard-card">
                                            <div class="card-icon warning">
                                                <i class="fas fa-exclamation-circle"></i>
                                            </div>
                                            <div class="card-content">
                                                <h3 class="card-title">Overdue</h3>
                                                <p class="card-value">
                                                    <%= emiSummary.overdueEmis || 0 %> EMIs
                                                </p>
                                            </div>
                                        </div>
                                        <div class="dashboard-card">
                                            <div class="card-icon success">
                                                <i class="fas fa-check-circle"></i>
                                            </div>
                                            <div class="card-content">
                                                <h3 class="card-title">Paid</h3>
                                                <p class="card-value">
                                                    <%= emiSummary.paidEmis || 0 %> EMIs
                                                </p>
                                            </div>
                                        </div>
                                        <div class="dashboard-card">
                                            <div class="card-icon info">
                                                <i class="fas fa-calendar"></i>
                                            </div>
                                            <div class="card-content">
                                                <h3 class="card-title">Next Payment</h3>
                                                <% if (emiSummary.nextDueEmi) { %>
                                                    <p class="card-value">
                                                        <%= new
                                                            Date(emiSummary.nextDueEmi.dueDate).toLocaleDateString('en-IN',
                                                            { day: 'numeric' , month: 'short' , year: 'numeric' }) %>
                                                    </p>
                                                    <% } else { %>
                                                        <p class="card-value">No upcoming payments</p>
                                                        <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="progress-container">
                                        <div class="progress-details">
                                            <h3>Payment Progress</h3>
                                            <span>
                                                <%= Math.round(emiSummary.paymentProgress || 0) %>
                                                    <%='%'%> Complete
                                            </span>
                                        </div>
                                        <div class="progress-bar">
                                            <div
                                                class="progress progress-<%= Math.round((emiSummary.paymentProgress || 0) / 10) * 10 %>">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Loan Summaries -->
                                <div class="loan-summaries-section">
                                    <h2>Your Active Loans</h2>
                                    <div class="loan-summary-cards">
                                        <% loanSummaries.forEach(loan=> { %>
                                            <div class="loan-summary-card">
                                                <div class="loan-summary-header">
                                                    <div class="loan-type-badge">
                                                        <%= loan.loanType.replace('_', ' ' ).replace(/\b\w/g, l=>
                                                            l.toUpperCase()) %>
                                                    </div>
                                                    <h3 class="loan-amount">₹<%= loan.loanAmount.toLocaleString('en-IN')
                                                            %>
                                                    </h3>
                                                </div>
                                                <div class="loan-summary-body">
                                                    <% if (loan.pendingEmiCount===0 && loan.paidEmiCount> 0) { %>
                                                        <div style="text-align: center; padding: 1rem 0;">
                                                            <i class="fas fa-medal"
                                                                style="font-size: 2.5rem; color: #2e7d32; margin-bottom: 0.5rem;"></i>
                                                            <h3 style="color: #2e7d32; margin-bottom: 1rem;">Loan Fully
                                                                Paid Off!</h3>
                                                            <p style="color: #666;">You have successfully paid off this
                                                                loan.</p>
                                                        </div>
                                                        <% } %>
                                                            <div class="summary-row">
                                                                <span>Paid:</span>
                                                                <span>₹<%= loan.totalPaid.toLocaleString('en-IN') %>
                                                                        </span>
                                                            </div>
                                                            <div class="summary-row">
                                                                <span>Principal Paid:</span>
                                                                <span>₹<%=
                                                                        loan.totalPrincipalPaid.toLocaleString('en-IN',
                                                                        { maximumFractionDigits: 0 }) %></span>
                                                            </div>
                                                            <div class="summary-row">
                                                                <span>Interest Paid:</span>
                                                                <span>₹<%=
                                                                        loan.totalInterestPaid.toLocaleString('en-IN', {
                                                                        maximumFractionDigits: 0 }) %></span>
                                                            </div>
                                                            <% if (loan.totalLatePaymentFees> 0) { %>
                                                                <div class="summary-row">
                                                                    <span>Late Fees:</span>
                                                                    <span>₹<%=
                                                                            loan.totalLatePaymentFees.toLocaleString('en-IN')
                                                                            %></span>
                                                                </div>
                                                                <% } %>
                                                                    <div class="summary-row highlighted">
                                                                        <span>Remaining Balance:</span>
                                                                        <span>₹<%=
                                                                                loan.remainingBalance.toLocaleString('en-IN',
                                                                                { maximumFractionDigits: 0 }) %></span>
                                                                    </div>
                                                                    <div class="summary-row">
                                                                        <span>Loan Status:</span>
                                                                        <span
                                                                            class="status-badge <%= loan.loanStatus === 'fully_paid' ? 'status-paid' : loan.loanStatus === 'defaulted' ? 'status-overdue' : 'status-pending' %>">
                                                                            <%= loan.loanStatus==='fully_paid'
                                                                                ? 'Fully Paid' :
                                                                                loan.loanStatus==='in_progress'
                                                                                ? 'In Progress' :
                                                                                loan.loanStatus==='defaulted'
                                                                                ? 'Defaulted' :
                                                                                loan.loanStatus==='not_started'
                                                                                ? 'Not Started' : 'In Progress' %>
                                                                        </span>
                                                                    </div>
                                                </div>
                                                <div class="loan-summary-footer">
                                                    <div class="emi-progress">
                                                        <div class="progress-bar">
                                                            <div
                                                                class="progress progress-<%= Math.round(((loan.paidEmiCount || 0) / Math.max((loan.paidEmiCount || 0) + (loan.pendingEmiCount || 0), 1)) * 10) * 10 %>">
                                                            </div>
                                                        </div>
                                                        <div class="progress-text">
                                                            <span>
                                                                <%= loan.paidEmiCount || 0 %> of <%= (loan.paidEmiCount
                                                                        || 0) + (loan.pendingEmiCount || 0) ||
                                                                        (loan.loanAmount && loan.interestRate ?
                                                                        Math.ceil(loan.loanAmount / loan.interestRate) :
                                                                        240) %> EMIs paid
                                                            </span>
                                                            <span>
                                                                <%= Math.round(((loan.paidEmiCount || 0) /
                                                                    Math.max((loan.paidEmiCount || 0) +
                                                                    (loan.pendingEmiCount || 0), 1)) * 100) %>% Complete
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                </div>
                                <% } %>

                                    <% if (overdueEmis && overdueEmis.length> 0) { %>
                                        <div class="overdue-section">
                                            <div class="section-header">
                                                <h2>Overdue Payments</h2>
                                                <span class="badge overdue-badge">
                                                    <%= overdueEmis.length %> Overdue
                                                </span>
                                            </div>
                                            <div class="overdue-cards">
                                                <% overdueEmis.forEach(emi=> { %>
                                                    <div class="overdue-card">
                                                        <div class="overdue-details">
                                                            <div class="overdue-loan-info">
                                                                <div class="loan-type-badge">
                                                                    <%= emi.loanId.loanDetails.loanType.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) || 'Home Loan' %>
                                                                </div>
                                                                <div class="overdue-date">
                                                                    Due: <strong>
                                                                        <%= new
                                                                            Date(emi.dueDate).toLocaleDateString('en-IN',
                                                                            { day: 'numeric' , month: 'short' ,
                                                                            year: 'numeric' }) %>
                                                                    </strong>
                                                                </div>
                                                            </div>
                                                            <div class="overdue-amount">
                                                                <h3>₹<%= emi.amount.toLocaleString('en-IN') %>
                                                                </h3>
                                                                <div class="days-overdue">
                                                                    <%= Math.ceil((new Date() - new Date(emi.dueDate)) /
                                                                        (1000 * 60 * 60 * 24)) %> days overdue
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="overdue-action">
                                                            <button class="pay-btn overdue-pay-btn"
                                                                onclick="openPaymentModal('<%= emi._id %>', '<%= emi.amount %>', true)">Pay
                                                                Now</button>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                            <div class="overdue-warning">
                                                <i class="fas fa-exclamation-triangle"></i>
                                                <p>Late payments may affect your credit score. Please clear overdue
                                                    payments as soon as possible.</p>
                                            </div>
                                        </div>
                                        <% } %>

                                            <div class="tab-container">
                                                <div class="tabs">
                                                    <div class="tab active" data-tab="pending-tab">Upcoming EMIs</div>
                                                    <div class="tab" data-tab="future-tab">Future Installments</div>
                                                    <div class="tab" data-tab="missed-tab">Missed Payments</div>
                                                    <div class="tab" data-tab="history-tab">Payment History</div>
                                                </div>

                                                <div id="pending-tab" class="tab-content active">
                                                    <% if (emiPayments && emiPayments.length> 0) { %>
                                                        <% emiPayments.forEach(loan=> { %>
                                                            <div class="loan-card">
                                                                <div class="loan-type">
                                                                    <%= loan.loanType ? loan.loanType.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) : 'Home Loan' %>
                                                                </div>
                                                                <div class="loan-amount">₹<%=
                                                                        loan.loanAmount.toLocaleString('en-IN') %>
                                                                </div>
                                                                <div class="loan-details">
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Interest Rate</span>
                                                                        <span class="detail-value">
                                                                            <%= loan.interestRate %>%
                                                                        </span>
                                                                    </div>
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Tenure</span>
                                                                        <span class="detail-value">
                                                                            <%= loan.tenure %> years
                                                                        </span>
                                                                    </div>
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Monthly EMI</span>
                                                                        <span class="detail-value">₹<%=
                                                                                loan.emi.toLocaleString('en-IN') %>
                                                                                </span>
                                                                    </div>
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Loan ID</span>
                                                                        <span class="detail-value">
                                                                            <%= loan.loanId.substr(0, 8) %>...
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <table class="emi-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Due Date</th>
                                                                        <th>EMI #</th>
                                                                        <th>Amount</th>
                                                                        <th>Principal</th>
                                                                        <th>Interest</th>
                                                                        <th>Status</th>
                                                                        <th>Action</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <% 
                                                                        // Get today's date for comparison 
                                                                        const today = new Date(); 
                                                                        // Display only the next 2 upcoming EMIs that are pending 
                                                                        loan.payments
                                                                        .filter(payment => payment.status === 'pending')
                                                                        .sort((a, b) => new Date(a.dueDate) - new Date(b.dueDate))
                                                                        .slice(0, 2) // Only take the first 2 EMIs
                                                                        .forEach(payment => {
                                                                    %>
                                                                        <tr
                                                                            class="<%= new Date(payment.dueDate) < today ? 'overdue-row' : '' %>">
                                                                            <td>
                                                                                <%= new
                                                                                    Date(payment.dueDate).toLocaleDateString('en-IN',
                                                                                    { day: 'numeric' , month: 'short' ,
                                                                                    year: 'numeric' }) %>
                                                                            </td>
                                                                            <td>
                                                                                <%= payment.emiNumber || '1' %> of <%=
                                                                                        (loan.loanDetails &&
                                                                                        loan.loanDetails.loanTenure) ?
                                                                                        loan.loanDetails.loanTenure * 12
                                                                                        : payment.emiNumber ?
                                                                                        payment.emiNumber : 240 %>
                                                                            </td>
                                                                            <td>₹<%= payment.amount.toLocaleString('en-IN')
                                                                                    %>
                                                                            </td>
                                                                            <td>₹<%= payment.principalAmount.toLocaleString('en-IN',
                                                                                    { maximumFractionDigits: 0 }) %>
                                                                            </td>
                                                                            <td>₹<%= payment.interestAmount.toLocaleString('en-IN',
                                                                                    { maximumFractionDigits: 0 }) %>
                                                                            </td>
                                                                            <td>
                                                                                <span
                                                                                    class="status-badge <%= new Date(payment.dueDate) < today ? 'status-overdue' : 'status-pending' %>">
                                                                                    <%= new Date(payment.dueDate) <
                                                                                        today ? 'Overdue' : 'Pending' %>
                                                                                </span>
                                                                            </td>
                                                                            <td>
                                                                                <button
                                                                                    class="pay-btn <%= new Date(payment.dueDate) < today ? 'overdue-btn' : '' %>"
                                                                                    onclick="openPaymentModal('<%= payment._id %>', '<%= payment.amount %>', '<%= new Date(payment.dueDate) < today %>')">
                                                                                    Pay Now
                                                                                </button>
                                                                                <button class="invoice-btn"
                                                                                    data-payment-id="<%= payment._id %>"
                                                                                    data-emi-number="<%= payment.emiNumber || 1 %>"
                                                                                    data-amount="<%= payment.amount %>"
                                                                                    data-principal="<%= payment.principalAmount || 0 %>"
                                                                                    data-interest="<%= payment.interestAmount || 0 %>"
                                                                                    data-due-date="<%= payment.dueDate %>"
                                                                                    data-loan-id="<%= payment.loanId ? payment.loanId._id : '' %>"
                                                                                    data-loan-type="<%= payment.loanId && payment.loanId.loanDetails ? payment.loanId.loanDetails.loanType : 'Home_Loan' %>"
                                                                                    data-late-fee="0"
                                                                                    data-payment-date="<%= payment.paymentDate || '' %>"
                                                                                    data-transaction-id="<%= payment.transactionId || '' %>"
                                                                                    data-payment-method="<%= payment.paymentMethod || '' %>"
                                                                                    onclick="generateInvoiceFromData(this)">
                                                                                    Invoice
                                                                                </button>
                                                                            </td>
                                                                        </tr>
                                                                        <% }); %>
                                                                </tbody>
                                                            </table>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <div class="empty-state">
                                                                        <% if (locals.loanSummaries &&
                                                                            loanSummaries.some(loan=>
                                                                            loan.pendingEmiCount === 0 &&
                                                                            loan.paidEmiCount > 0)) { %>
                                                                            <i class="fas fa-award"
                                                                                style="color: #2e7d32;"></i>
                                                                            <h3>Loan Fully Paid Off!</h3>
                                                                            <p>Congratulations! You have successfully
                                                                                paid off your loan. No more EMIs are
                                                                                pending.</p>
                                                                            <a href="/loan/apply"
                                                                                class="explore-btn">Apply for a New
                                                                                Loan</a>
                                                                            <% } else { %>
                                                                                <i class="fas fa-money-check-alt"></i>
                                                                                <h3>No EMI Payments Found</h3>
                                                                                <p>
                                                                                    <%= locals.message
                                                                                        || "You don't have any upcoming EMI payments. Apply for a home loan to get started."
                                                                                        %>
                                                                                </p>
                                                                                <a href="/loan/emi-calculator"
                                                                                    class="explore-btn">Explore Loan
                                                                                    Options</a>
                                                                                <% } %>
                                                                    </div>
                                                                    <% } %>
                                                </div>

                                                <div id="missed-tab" class="tab-content">
                                                    <% if (missedEmis && missedEmis.length> 0) { %>
                                                        <div class="alert-message"
                                                            style="background-color: #ffebee; color: #c62828; border-left-color: #c62828;">
                                                            <p><i class="fas fa-exclamation-triangle"></i> Missed
                                                                payments may significantly impact your credit score.
                                                                Please clear these payments as soon as possible to avoid
                                                                further penalties.</p>
                                                        </div>

                                                        <table class="emi-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Due Date</th>
                                                                    <th>EMI #</th>
                                                                    <th>Days Late</th>
                                                                    <th>Amount</th>
                                                                    <th>Penalty</th>
                                                                    <th>Total Due</th>
                                                                    <th>Action</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% missedEmis.forEach(payment=> { %>
                                                                    <tr class="overdue-row">
                                                                        <td>
                                                                            <%= new
                                                                                Date(payment.dueDate).toLocaleDateString('en-IN',
                                                                                { day: 'numeric' , month: 'short' ,
                                                                                year: 'numeric' }) %>
                                                                        </td>
                                                                        <td>
                                                                            <%= payment.emiNumber || '1' %> of <%=
                                                                                    (loan.loanDetails &&
                                                                                    loan.loanDetails.loanTenure) ?
                                                                                    loan.loanDetails.loanTenure * 12 :
                                                                                    payment.emiNumber ?
                                                                                    payment.emiNumber : 240 %>
                                                                        </td>
                                                                        <td>
                                                                            <%= payment.daysLate || Math.ceil((new
                                                                                Date() - new Date(payment.dueDate)) /
                                                                                (1000 * 60 * 60 * 24)) %> days
                                                                        </td>
                                                                        <td>₹<%= payment.amount.toLocaleString('en-IN')
                                                                                %>
                                                                        </td>
                                                                        <td>₹<%= payment.latePaymentFee.toLocaleString('en-IN')
                                                                                %>
                                                                        </td>
                                                                        <td>₹<%= (payment.amount +
                                                                                payment.latePaymentFee).toLocaleString('en-IN')
                                                                                %>
                                                                        </td>
                                                                        <td>
                                                                            <button class="pay-btn overdue-btn"
                                                                                onclick="openPaymentModal('<%= payment._id %>', '<%= payment.amount %>', true, '<%= payment.latePaymentFee %>')">
                                                                                Pay Now
                                                                            </button>
                                                                            <button class="invoice-btn"
                                                                                data-payment-id="<%= payment._id %>"
                                                                                data-emi-number="<%= payment.emiNumber || 1 %>"
                                                                                data-amount="<%= payment.amount %>"
                                                                                data-principal="<%= payment.principalAmount || 0 %>"
                                                                                data-interest="<%= payment.interestAmount || 0 %>"
                                                                                data-due-date="<%= payment.dueDate %>"
                                                                                data-loan-id="<%= payment.loanId ? payment.loanId._id : '' %>"
                                                                                data-loan-type="<%= payment.loanId && payment.loanId.loanDetails ? payment.loanId.loanDetails.loanType : 'Home_Loan' %>"
                                                                                data-late-fee="<%= payment.latePaymentFee || 0 %>"
                                                                                onclick="generateInvoiceFromData(this)">
                                                                                Invoice
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                    <% }); %>
                                                            </tbody>
                                                        </table>
                                                        <% } else { %>
                                                            <div class="empty-state">
                                                                <% if (locals.loanSummaries && loanSummaries.some(loan=>
                                                                    loan.pendingEmiCount === 0 && loan.paidEmiCount >
                                                                    0)) { %>
                                                                    <i class="fas fa-trophy"
                                                                        style="color: #2e7d32;"></i>
                                                                    <h3>Perfect Payment Record!</h3>
                                                                    <p>Excellent job maintaining a clean payment record!
                                                                        Your loan is fully paid with no missed payments.
                                                                    </p>
                                                                    <% } else { %>
                                                                        <i class="fas fa-check-circle"
                                                                            style="color: #2e7d32;"></i>
                                                                        <h3>No Missed Payments</h3>
                                                                        <p>Great job! You have no missed payments.</p>
                                                                        <% } %>
                                                            </div>
                                                            <% } %>
                                                </div>

                                                <div id="future-tab" class="tab-content">
                                                    <% if (emiPayments && emiPayments.length> 0) { %>
                                                        <% emiPayments.forEach(loan=> { %>
                                                            <div class="loan-card">
                                                                <div class="loan-type">
                                                                    <%= loan.loanType ? loan.loanType.replace('_', ' '
                                                                        ).replace(/\b\w/g, l=> l.toUpperCase()) : 'Home Loan' %>
                                                                </div>
                                                                <div class="loan-amount">₹<%=
                                                                        loan.loanAmount.toLocaleString('en-IN') %>
                                                                </div>
                                                                <div class="loan-details">
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Interest Rate</span>
                                                                        <span class="detail-value">
                                                                            <%= loan.interestRate %>%
                                                                        </span>
                                                                    </div>
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Tenure</span>
                                                                        <span class="detail-value">
                                                                            <%= loan.tenure %> years
                                                                        </span>
                                                                    </div>
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Monthly EMI</span>
                                                                        <span class="detail-value">₹<%=
                                                                                loan.emi.toLocaleString('en-IN') %>
                                                                                </span>
                                                                    </div>
                                                                    <div class="detail-item">
                                                                        <span class="detail-label">Loan ID</span>
                                                                        <span class="detail-value">
                                                                            <%= loan.loanId.substr(0, 8) %>...
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <table class="emi-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Due Date</th>
                                                                        <th>EMI #</th>
                                                                        <th>Amount</th>
                                                                        <th>Principal</th>
                                                                        <th>Interest</th>
                                                                        <th>Remaining Balance</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    <% 
                                                                        const today = new Date(); 
                                                                        const threeMonthsLater = new Date();
                                                                        threeMonthsLater.setMonth(today.getMonth() + 3);
                                                                        loan.payments
                                                                        .filter(payment => payment.status === 'pending' && new Date(payment.dueDate) > threeMonthsLater)
                                                                        .forEach(payment => {
                                                                    %>
                                                                        <tr>
                                                                            <td>
                                                                                <%= new
                                                                                    Date(payment.dueDate).toLocaleDateString('en-IN',
                                                                                    { day: 'numeric' , month: 'short' ,
                                                                                    year: 'numeric' }) %>
                                                                            </td>
