        <%- include('./partials/footer') %>

            <script>
                let selectedMethod = '';
                let currentEmiId = '';
                let emiAmount = 0;
                let latePaymentFee = 0;

                // Tab switching
                document.querySelectorAll('.tab').forEach(tab => {
                    tab.addEventListener('click', () => {
                        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                        tab.classList.add('active');
                        document.getElementById(tab.dataset.tab).classList.add('active');
                    });
                });

                // Payment modal functions
                function openPaymentModal(emiId, amount, isOverdue, penaltyAmount = 0) {
                    currentEmiId = emiId;
                    emiAmount = parseFloat(amount);

                    // Calculate late fee if payment is overdue
                    latePaymentFee = 0;
                    if (isOverdue) {
                        // If penalty amount is provided, use it, otherwise use default 200
                        latePaymentFee = penaltyAmount ? parseFloat(penaltyAmount) : 200;
                    }

                    document.getElementById('emiId').value = emiId;
                    document.getElementById('summaryEmiAmount').innerText = '₹' + parseFloat(amount).toLocaleString('en-IN');
                    document.getElementById('summaryLateFee').innerText = '₹' + latePaymentFee.toLocaleString('en-IN');
                    document.getElementById('summaryTotal').innerText = '₹' + (parseFloat(amount) + latePaymentFee).toLocaleString('en-IN');

                    document.getElementById('paymentModal').style.display = 'flex';
                }

                function closePaymentModal() {
                    document.getElementById('paymentModal').style.display = 'none';
                    resetPaymentForm();
                }

                function selectPaymentMethod(method) {
                    selectedMethod = method;
                    document.getElementById('paymentMethod').value = method;

                    document.querySelectorAll('.payment-method-option').forEach(option => {
                        option.classList.remove('selected');
                    });

                    document.querySelector(`.payment-method-option[data-method="${method}"]`).classList.add('selected');

                    // Hide all payment fields
                    document.querySelectorAll('.payment-fields').forEach(field => {
                        field.style.display = 'none';
                    });

                    // Show relevant fields based on selected method
                    if (method === 'credit_card' || method === 'debit_card') {
                        document.getElementById('creditCardFields').style.display = 'block';
                    } else if (method === 'upi') {
                        document.getElementById('upiFields').style.display = 'block';
                    } else if (method === 'net_banking') {
                        document.getElementById('netBankingFields').style.display = 'block';
                    }
                }

                function resetPaymentForm() {
                    document.getElementById('paymentForm').reset();
                    document.querySelectorAll('.payment-method-option').forEach(option => {
                        option.classList.remove('selected');
                    });
                    document.querySelectorAll('.payment-fields').forEach(field => {
                        field.style.display = 'none';
                    });
                    selectedMethod = '';
                    latePaymentFee = 0;
                }

                // Payment form submission
                document.getElementById('paymentForm').addEventListener('submit', async function (e) {
                    e.preventDefault();

                    if (!selectedMethod) {
                        alert('Please select a payment method');
                        return;
                    }

                    // Validation based on payment method
                    if ((selectedMethod === 'credit_card' || selectedMethod === 'debit_card') &&
                        (!document.getElementById('cardNumber').value ||
                            !document.getElementById('cardName').value ||
                            !document.getElementById('expiry').value ||
                            !document.getElementById('cvv').value)) {
                        alert('Please fill all card details');
                        return;
                    }

                    if (selectedMethod === 'upi' && !document.getElementById('upiId').value) {
                        alert('Please enter UPI ID');
                        return;
                    }

                    if (selectedMethod === 'net_banking' && !document.getElementById('bankName').value) {
                        alert('Please select a bank');
                        return;
                    }

                    // Generate transaction ID (in real app, this would come from payment gateway)
                    const transactionId = 'TXN' + Math.floor(Math.random() * 1000000000);

                    try {
                        const response = await fetch(`/loan/pay-emi/${currentEmiId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                paymentMethod: selectedMethod,
                                transactionId: transactionId
                            })
                        });

                        const data = await response.json();

                        if (data.success) {
                            alert('Payment successful! Transaction ID: ' + transactionId);
                            closePaymentModal();
                            location.reload(); // Reload the page to show updated status
                        } else {
                            alert('Payment failed: ' + data.message);
                        }
                    } catch (error) {
                        console.error('Error processing payment:', error);
                        alert('Payment failed. Please try again later.');
                    }
                });

                // Invoice functions
                function generateInvoiceFromData(button) {
                    const data = button.dataset;
                    generateInvoice(
                        data.paymentId,
                        data.emiNumber,
                        data.amount,
                        data.principal,
                        data.interest,
                        data.dueDate,
                        data.loanId,
                        data.loanType,
                        data.lateFee,
                        data.paymentDate || null,
                        data.transactionId || null,
                        data.paymentMethod || null
                    );
                }

                function generateInvoice(emiId, emiNumber, amount, principalAmount, interestAmount, dueDate, loanId, loanType, lateFee = 0, paymentDate = null, transactionId = null, paymentMethod = null) {
                    // Format the dates
                    const formattedDueDate = new Date(dueDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
                    const today = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

                    // Generate invoice number (would be better done server-side in production)
                    const invoiceNumber = 'INV-' + Math.floor(Math.random() * 1000000).toString().padStart(6, '0');

                    // Set invoice data
                    document.getElementById('invoiceNumber').innerText = invoiceNumber;
                    document.getElementById('invoiceDate').innerText = today;
                    document.getElementById('loanDescription').innerText = loanType.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) + ' EMI Payment';
                    document.getElementById('loanId').innerText = loanId.substr(0, 8) + '...';
                    document.getElementById('emiNumber').innerText = emiNumber + ' of ' + (240); // Assumming 240 EMIs (20 years)
                    document.getElementById('emiDueDate').innerText = formattedDueDate;
                    document.getElementById('emiAmount').innerText = '₹' + parseFloat(amount).toLocaleString('en-IN');

                    document.getElementById('principalAmount').innerText = '₹' + parseFloat(principalAmount).toLocaleString('en-IN', { maximumFractionDigits: 0 });
                    document.getElementById('interestAmount').innerText = '₹' + parseFloat(interestAmount).toLocaleString('en-IN', { maximumFractionDigits: 0 });

                    // Handle late fees if applicable
                    if (lateFee && parseFloat(lateFee) > 0) {
                        document.getElementById('lateFeeRow').style.display = 'flex';
                        document.getElementById('lateFeeAmount').innerText = '₹' + parseFloat(lateFee).toLocaleString('en-IN');
                        document.getElementById('totalAmount').innerText = '₹' + (parseFloat(amount) + parseFloat(lateFee)).toLocaleString('en-IN');
                    } else {
                        document.getElementById('lateFeeRow').style.display = 'none';
                        document.getElementById('totalAmount').innerText = '₹' + parseFloat(amount).toLocaleString('en-IN');
                    }

                    // Set customer info (in a real app, this would be fetched from user profile)
                    document.getElementById('customerName').innerText = '<%= locals.user ? user.name : "Customer" %>';
                    document.getElementById('customerAddress').innerText = '<%= locals.user && user.address ? user.address : "Address not provided" %>';
                    document.getElementById('customerContact').innerText = '<%= locals.user && user.email ? user.email : "Email not provided" %>';

                    // Show payment details if provided (for paid EMIs)
                    if (paymentDate && transactionId && paymentMethod) {
                        document.getElementById('paymentStatus').innerText = 'Paid';
                        document.getElementById('paymentDetails').style.display = 'block';
                        document.getElementById('transactionId').innerText = transactionId;
                        document.getElementById('paymentDate').innerText = new Date(paymentDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
                        document.getElementById('paymentMethod').innerText = paymentMethod.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase());
                    } else {
                        document.getElementById('paymentStatus').innerText = 'Pending';
                        document.getElementById('paymentDetails').style.display = 'none';
                    }

                    // Show the invoice modal
                    document.getElementById('invoiceModal').style.display = 'flex';
                }

                function closeInvoiceModal() {
                    document.getElementById('invoiceModal').style.display = 'none';
                }

                function printInvoice() {
                    // Create a new window for printing
                    const printWindow = window.open('', '_blank');

                    // Get the invoice content
                    const invoiceContent = document.getElementById('invoiceContent').cloneNode(true);

                    // Create a simple document with just the invoice
                    printWindow.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>EMI Payment Invoice</title>
                    <style>
                        body {
                            font-family: 'Inter', Arial, sans-serif;
                            line-height: 1.6;
                            color: #333;
                            padding: 2rem;
                        }
                        .invoice-company {
                            margin-bottom: 2rem;
                        }
                        .invoice-company h3 {
                            color: #333;
                            margin-bottom: 0.5rem;
                        }
                        .invoice-company p {
                            margin: 0.25rem 0;
                            color: #666;
                        }
                        .invoice-details {
                            display: flex;
                            justify-content: space-between;
                            margin-bottom: 2rem;
                        }
                        .invoice-section {
                            flex: 1;
                        }
                        .invoice-section h4 {
                            color: #333;
                            margin-bottom: 0.5rem;
                            font-size: 1rem;
                        }
                        .invoice-data {
                            margin: 0.25rem 0;
                            color: #333;
                        }
                        .invoice-data span {
                            font-weight: 600;
                        }
                        .invoice-table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 2rem;
                        }
                        .invoice-table th,
                        .invoice-table td {
                            padding: 0.75rem;
                            text-align: left;
                            border-bottom: 1px solid #eee;
                        }
                        .invoice-table th {
                            background-color: #f5f5f5;
                            font-weight: 600;
                            color: #333;
                        }
                        .invoice-summary {
                            margin-left: auto;
                            width: 40%;
                        }
                        .invoice-summary-row {
                            display: flex;
                            justify-content: space-between;
                            padding: 0.5rem 0;
                            border-bottom: 1px solid #eee;
                        }
                        .invoice-summary-row:last-child {
                            border-bottom: none;
                            font-weight: 700;
                            font-size: 1.1rem;
                            padding-top: 1rem;
                        }
                        .invoice-footer {
                            margin-top: 3rem;
                            padding-top: 1rem;
                            border-top: 1px solid #eee;
                            color: #666;
                            font-size: 0.9rem;
                        }
                        .invoice-note {
                            margin-top: 1rem;
                            font-style: italic;
                        }
                    </style>
                </head>
                <body>
                    <div class="invoice-header">
                        <h2>Payment Invoice</h2>
                    </div>
                    ${invoiceContent.outerHTML}
                </body>
                </html>
            `);

                    // Print the new window
                    printWindow.document.close();
                    printWindow.focus();

                    // Wait for resources to load then print
                    setTimeout(() => {
                        printWindow.print();
                        printWindow.close();
                    }, 500);
                }

                function downloadInvoice() {
                    // In a real app, you would implement PDF generation
                    // For now, we'll just show an alert
                    alert('PDF download functionality would be implemented here.\nFor now, please use the Print option and save as PDF.');
                }

                // Auto-generate EMI schedule for approved loans
                window.addEventListener('load', async function () {
                    try {
                        // Get all loan cards
                        const loanCards = document.querySelectorAll('.loan-card');

                        // If no loans or empty state is shown, don't proceed
                        if (loanCards.length === 0 || document.querySelector('.empty-state')) {
                            return;
                        }

                        // Get all approved loans without EMI schedules
                        const response = await fetch('/loan/my-applications');
                        const data = await response.json();

                        if (data.success && data.applications) {
                            // Filter for approved loans
                            const approvedLoans = data.applications.filter(loan =>
                                loan.applicationStatus === 'approved');

                            // Generate EMI schedule for each approved loan
                            for (const loan of approvedLoans) {
                                try {
                                    await fetch(`/loan/generate-emi-schedule/${loan._id}`, {
                                        method: 'POST'
                                    });
                                    // We don't need to handle the response here
                                } catch (error) {
                                    console.error('Error generating EMI schedule:', error);
                                }
                            }

                            // If we generated any EMI schedules and the page shows empty state,
                            // reload to show the new schedules
                            if (approvedLoans.length > 0 && document.querySelector('.empty-state')) {
                                location.reload();
                            }
                        }
                    } catch (error) {
                        console.error('Error checking for approved loans:', error);
                    }
                });
            </script>
</body>

</html>
