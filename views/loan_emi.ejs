    <!-- Loan Application Form Section -->
    <div class="loan-application-container" id="loanApplicationSection">
        <div class="application-header">
            <h2>Apply for Home Loan</h2>
            <p>Fill in your details and get instant approval</p>
        </div>

        <% if (user) { %>
            <form id="loanApplicationForm" class="loan-form" enctype="multipart/form-data" onsubmit="submitLoanApplication(event)">
                <div class="form-grid">
                    <!-- Personal Information -->
                    <div class="form-section">
                        <h3>Personal Information</h3>
                        <div class="input-group">
                            <input type="text" id="fullName" name="fullName" value="<%= user.name %>" required>
                            <label for="fullName">Full Name</label>
                            <span class="error-message"></span>
                        </div>
                        <div class="input-row">
                            <div class="input-group">
                                <input type="email" id="email" name="email" value="<%= user.email %>" required>
                                <label for="email">Email Address</label>
                                <span class="error-message"></span>
                            </div>
                            <div class="input-group">
                                <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>" required>
                                <label for="phone">Phone Number</label>
                                <span class="error-message"></span>
                            </div>
                        </div>
                        <div class="input-row">
                            <div class="input-group">
                                <input type="date" id="dob" name="dob" required>
                                <label for="dob">Date of Birth</label>
                                <span class="error-message"></span>
                            </div>
                            <div class="input-group">
                                <select id="maritalStatus" name="maritalStatus" required>
                                    <option value="">Select Status</option>
                                    <option value="single">Single</option>
                                    <option value="married">Married</option>
                                    <option value="divorced">Divorced</option>
                                </select>
                                <label for="maritalStatus">Marital Status</label>
                                <span class="error-message"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Employment Details -->
                    <div class="form-section">
                        <h3>Employment Details</h3>
                        <div class="input-group">
                            <select id="employmentType" name="employmentType" required>
                                <option value="">Select Type</option>
                                <option value="salaried">Salaried</option>
                                <option value="self-employed">Self Employed</option>
                                <option value="business">Business Owner</option>
                            </select>
                            <label for="employmentType">Employment Type</label>
                            <span class="error-message"></span>
                        </div>
                        <div class="input-row">
                            <div class="input-group">
                                <input type="number" id="monthlyIncome" name="monthlyIncome" required>
                                <label for="monthlyIncome">Monthly Income (₹)</label>
                                <span class="error-message"></span>
                            </div>
                            <div class="input-group">
                                <input type="number" id="workExperience" name="workExperience" required>
                                <label for="workExperience">Work Experience (Years)</label>
                                <span class="error-message"></span>
                            </div>
                        </div>
                        <div class="input-row">
                            <div class="input-group">
                                <input type="text" id="employerName" name="employerName">
                                <label for="employerName">Employer/Company Name</label>
                                <span class="error-message"></span>
                            </div>
                            <div class="input-group">
                                <input type="text" id="designation" name="designation">
                                <label for="designation">Designation/Role</label>
                                <span class="error-message"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Loan Requirements -->
                    <div class="form-section">
                        <h3>Loan Requirements</h3>
                        <div class="input-row">
                            <div class="input-group">
                                <input type="number" id="loanAmount" name="loanAmount" required>
                                <label for="loanAmount">Loan Amount (₹)</label>
                                <span class="error-message"></span>
                            </div>
                            <div class="input-group">
                                <input type="number" id="loanTenure" name="loanTenure" required>
                                <label for="loanTenure">Loan Tenure (Years)</label>
                                <span class="error-message"></span>
                            </div>
                        </div>
                        <div class="input-row">
                            <div class="input-group">
                                <select id="propertyType" name="propertyType" required>
                                    <option value="">Select Type</option>
                                    <option value="apartment">Apartment</option>
                                    <option value="independent">Independent House</option>
                                    <option value="villa">Villa</option>
                                    <option value="plot">Plot</option>
                                </select>
                                <label for="propertyType">Property Type</label>
                                <span class="error-message"></span>
                            </div>
                            <div class="input-group">
                                <select id="loanType" name="loanType" required>
                                    <option value="">Select Loan Type</option>
                                    <option value="affordable">Affordable Home Loan (< ₹50L)</option>
                                    <option value="premium">Premium Home Loan (₹50L - ₹1Cr)</option>
                                    <option value="luxury">Luxury Home Loan (> ₹1Cr)</option>
                                    <option value="construction">Home Construction Loan</option>
                                    <option value="renovation">Home Renovation Loan</option>
                                </select>
                                <label for="loanType">Home Loan Type</label>
                                <span class="error-message"></span>
                            </div>
                        </div>
                        <div class="input-row">
                            <div class="input-group">
                                <input type="number" id="propertyValue" name="propertyValue">
                                <label for="propertyValue">Property Value (₹)</label>
                                <span class="error-message"></span>
                            </div>
                            <div class="input-group">
                                <input type="text" id="propertyAddress" name="propertyAddress">
                                <label for="propertyAddress">Property Address</label>
                                <span class="error-message"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Document Uploads -->
                    <div class="form-section">
                        <h3>Document Uploads</h3>
                        <p class="upload-info">Please upload clear scans or photos of your documents (PDF or JPG/PNG format, max 5MB each)</p>
                        
                        <div class="document-group">
                            <div class="document-row">
                                <div class="document-item">
                                    <label class="document-label">Identity Proof (Aadhar/PAN)*</label>
                                    <input type="file" id="identityProof" name="identityProof" accept=".pdf,image/*" required>
                                    <div class="file-info">No file chosen</div>
                                </div>
                                <div class="document-item">
                                    <label class="document-label">Address Proof*</label>
                                    <input type="file" id="addressProof" name="addressProof" accept=".pdf,image/*" required>
                                    <div class="file-info">No file chosen</div>
                                </div>
                            </div>

                            <div class="document-row">
                                <div class="document-item">
                                    <label class="document-label">Income Proof (Salary Slips/ITR)*</label>
                                    <input type="file" id="incomeProof" name="incomeProof" accept=".pdf,image/*" required>
                                    <div class="file-info">No file chosen</div>
                                </div>
                                <div class="document-item">
                                    <label class="document-label">Bank Statements (Last 6 months)*</label>
                                    <input type="file" id="bankStatements" name="bankStatements" accept=".pdf,image/*" required>
                                    <div class="file-info">No file chosen</div>
                                </div>
                            </div>

                            <div class="document-row">
                                <div class="document-item">
                                    <label class="document-label">Property Documents</label>
                                    <input type="file" id="propertyDocuments" name="propertyDocuments" accept=".pdf,image/*">
                                    <div class="file-info">No file chosen</div>
                                </div>
                                <div class="document-item">
                                    <label class="document-label">Additional Documents</label>
                                    <input type="file" id="additionalDocs" name="additionalDocs" accept=".pdf,image/*" multiple>
                                    <div class="file-info">No file chosen</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-footer">
                    <label class="checkbox-container">
                        <input type="checkbox" id="terms" name="terms" required>
                        <span class="checkmark"></span>
                        I agree to the terms and conditions
                    </label>
                    <button type="submit" class="submit-btn">Submit Application</button>
                </div>

                <!-- Application Status Feedback -->
                <div id="application-status" class="application-status" style="display: none;"></div>
            </form>
        <% } else { %>
            <div class="login-required">
                <i class="fas fa-lock"></i>
                <h3>Please Login to Apply for a Loan</h3>
                <p>You need to be logged in to submit a loan application and track your application status.</p>
                <a href="/auth/signin?redirect=/loan" class="login-link">Login Now</a>
            </div>
        <% } %>
    </div>

    <!-- Add this after pricing-container -->
    <div class="faq-container">
        <div class="faq-left">
            <h2>Home Loan FAQs</h2>
            <img src="/assets/faq-illustration.png" alt="FAQ Illustration" class="faq-image">
        </div>

        <div class="faq-right">
            <div class="faq-item">
                <button class="faq-question">
                    Q. What is the formula for calculating Home Loan EMI?
                    <span class="arrow">&#9662;</span>
                </button>
                <div class="faq-answer">
                    <p>The Home Loan EMI is calculated using the formula:</p>
                    <p class="formula">EMI = P × r × (1 + r)^n / ((1 + r)^n - 1)</p>
                    <p>Where:</p>
                    <ul>
                        <li>P = Principal loan amount</li>
                        <li>r = Interest rate per month [Annual rate/12/100]</li>
                        <li>n = Total number of months</li>
                    </ul>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Q. What is Home Loan Pre-EMI?
                    <span class="arrow">&#9662;</span>
                </button>
                <div class="faq-answer">
                    <p>Pre-EMI is the interest paid on the loan amount disbursed before the full disbursement of the
                        loan. During the under-construction period, you only pay the interest on the amount disbursed,
                        and not the principal amount. Regular EMIs start after complete disbursement.</p>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Q. Are there any tax benefits on paying Home loan EMIs?
                    <span class="arrow">&#9662;</span>
                </button>
                <div class="faq-answer">
                    <p>Yes, there are tax benefits available under:</p>
                    <ul>
                        <li>Section 24: Interest paid up to ₹2 lakhs can be claimed as deduction</li>
                        <li>Section 80C: Principal repayment up to ₹1.5 lakhs can be claimed as deduction</li>
                        <li>Additional benefits for first-time homebuyers under Section 80EE</li>
                    </ul>
                </div>
            </div>

            <div class="faq-item">
                <button class="faq-question">
                    Q. What if I fail to pay my Home Loan EMI on time?
                    <span class="arrow">&#9662;</span>
                </button>
                <div class="faq-answer">
                    <p>Missing EMI payments can have several consequences:</p>
                    <ul>
                        <li>Late payment charges will be levied</li>
                        <li>Negative impact on your credit score</li>
                        <li>Additional interest charges</li>
                        <li>Legal action in case of continued default</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('./partials/footer') %>

    <!-- Back to Top Button -->
    <button id="backToTop" aria-label="Back to top">
        <a href="#top" aria-label="Scroll to top"><i class="fas fa-chevron-up"></i></a>
    </button>

    <script src="/js/loan.js"></script>
    <script>
        // Back to Top Button
        const backToTopButton = document.getElementById('backToTop');
        
        backToTopButton.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        window.addEventListener('scroll', () => {
            if (window.pageYOffset > 300) {
                backToTopButton.style.display = 'flex';
            } else {
                backToTopButton.style.display = 'none';
            }
        });

        // Ensure page starts at the top when loaded or refreshed
        window.onload = function() {
            window.scrollTo(0, 0);
            
            // Force scroll to top after a slight delay to override any browser behavior
            setTimeout(() => {
                window.scrollTo(0, 0);
            }, 50);
            
            // Initialize back to top button
            backToTopButton.style.display = 'none';
        };
    </script>
</body>

</html>