                            <p>+<%= (Math.random() * 10 + 5).toFixed(1) %>% annual appreciation</p>
                        </div>
                    </div>
                    <div class="trend-stat-item positive">
                        <i class="fas fa-home"></i>
                        <div class="trend-stat-info">
