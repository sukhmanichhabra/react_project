            <script>
                // Toggle functionality for collapsible sections
                function toggleContent(id) {
                    const content = document.getElementById(id);
                    const header = content.previousElementSibling;
                    const icon = header.querySelector('i');

                    content.classList.toggle('active');

                    if (content.classList.contains('active')) {
                        icon.classList.remove('fa-chevron-down');
                        icon.classList.add('fa-chevron-up');
                    } else {
                        icon.classList.remove('fa-chevron-up');
                        icon.classList.add('fa-chevron-down');
                    }
                }

                // Lifestyle modal functions
                function showLifestyleDetails(type) {
                    const modal = document.getElementById('lifestyleModal');
                    const modalContent = document.getElementById('lifestyleModalContent');

                    let title, places;

                    switch (type) {
                        case 'dining':
                            title = 'Dining & Nightlife Options';
                            places = [
                                {
                                    name: 'The Fine Table',
                                    image: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
                                    address: '123 Main St, Downtown',
                                    rating: 4.7,
                                    distance: '0.5 miles',
                                    price: '$$$'
                                },
                                {
                                    name: 'Café Sunrise',
                                    image: 'https://images.unsplash.com/photo-1554118811-1e0d58224f24?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
                                    address: '78 Broadway Ave',
                                    rating: 4.5,
                                    distance: '0.8 miles',
                                    price: '$$'
                                },
                                {
                                    name: 'Nightowl Lounge',
                                    image: 'https://images.unsplash.com/photo-1572116469696-31de0f17cc34?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
                                    address: '45 Park Lane',
                                    rating: 4.2,
                                    distance: '1.2 miles',
                                    price: '$$'
                                },
                                {
                                    name: 'Urban Spice',
                                    image: 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
                                    address: '230 Market St',
                                    rating: 4.8,
                                    distance: '0.7 miles',
                                    price: '$$$'
                                }
                            ];
                            break;

                        case 'shopping':
                            title = 'Shopping Options';
                            places = [
                                {
                                    name: 'City Center Mall',
                                    image: 'https://images.unsplash.com/photo-1581539250439-c96689b516dd?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
                                    address: '500 Commercial Ave',
                                    rating: 4.3,
                                    distance: '1.5 miles',
                                    price: 'Various'
                                },
                                {
                                    name: 'Fashion Avenue',
                                    image: 'https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
                                    address: '78 Luxury Lane',
                                    rating: 4.6,
                                    distance: '2.0 miles',
                                    price: '$$$'
                                },
                                {
                                    name: 'Daily Goods Market',
                                    image: 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
                                    address: '120 Corner St',
                                    rating: 4.4,
                                    distance: '0.4 miles',
                                    price: '$'
                                }
                            ];
                            break;

                        case 'recreation':
                            title = 'Recreation Options';
                            places = [
                                {
                                    name: 'Central Park',
                                    image: 'https://images.unsplash.com/photo-1551651653-c5186a1fbba2?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=60',
