                document.addEventListener('DOMContentLoaded', function () {
                    // Safety crime chart
                    const safetyChartCtx = document.getElementById('safetyCrimeChart').getContext('2d');

                    const safetyChart = new Chart(safetyChartCtx, {
                        type: 'bar',
                        data: {
                            labels: ['Theft', 'Assault', 'Burglary', 'Vandalism', 'Vehicle Theft'],
                            datasets: [{
                                label: 'Incidents per 1,000 residents',
                                data: [
                                    Math.random() * 5,
                                    Math.random() * 3,
                                    Math.random() * 4,
                                    Math.random() * 6,
                                    Math.random() * 2
                                ],
                                backgroundColor: [
                                    'rgba(52, 152, 219, 0.7)',
                                    'rgba(52, 152, 219, 0.7)',
                                    'rgba(52, 152, 219, 0.7)',
                                    'rgba(52, 152, 219, 0.7)',
                                    'rgba(52, 152, 219, 0.7)',
                                ],
                                borderColor: [
                                    'rgba(41, 128, 185, 1)',
                                    'rgba(41, 128, 185, 1)',
                                    'rgba(41, 128, 185, 1)',
                                    'rgba(41, 128, 185, 1)',
                                    'rgba(41, 128, 185, 1)',
                                ],
                                borderWidth: 1
                            },
                            {
                                label: 'City Average',
                                data: [6.2, 4.1, 5.3, 7.2, 3.8],
                                type: 'line',
                                fill: false,
                                borderColor: 'rgba(231, 76, 60, 1)',
                                backgroundColor: 'rgba(231, 76, 60, 1)',
                                pointBackgroundColor: 'rgba(231, 76, 60, 1)',
                                pointBorderColor: '#fff',
                                pointRadius: 4,
                                borderWidth: 2,
                                tension: 0.1
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    title: {
                                        display: true,
                                        text: 'Incidents per 1,000 residents'
                                    }
                                }
                            },
                            plugins: {
                                title: {
                                    display: true,
                                    text: 'Crime Statistics Comparison',
                                    font: {
                                        size: 16
                                    }
                                },
                                legend: {
                                    position: 'bottom'
                                },
                                tooltip: {
                                    mode: 'index',
                                    intersect: false
                                }
                            }
                        }
                    });

                    // Property trends chart
                    const trendsChartCtx = document.getElementById('propertyTrendsChart').getContext('2d');

                    // Generate data for the past 5 years
                    const years = [];
                    const propertyValues = [];
                    const cityAverages = [];

                    const currentYear = new Date().getFullYear();
                    const baseValue = 500000;
                    const cityBaseValue = 450000;
                    let propValue = baseValue;
                    let cityValue = cityBaseValue;

                    for (let i = 0; i < 5; i++) {
                        const year = currentYear - 4 + i;
                        years.push(year);

                        // Random growth between 3-8% for property
                        const propGrowth = 1 + (Math.random() * 0.05 + 0.03);
                        propValue *= propGrowth;
                        propertyValues.push(propValue);

                        // Random growth between 2-6% for city average
                        const cityGrowth = 1 + (Math.random() * 0.04 + 0.02);
                        cityValue *= cityGrowth;
                        cityAverages.push(cityValue);
                    }

                    // Add prediction for next 2 years
                    for (let i = 1; i <= 2; i++) {
                        const year = currentYear + i;
                        years.push(year);

                        // Random growth between 4-9% for property (future prediction)
                        const propGrowth = 1 + (Math.random() * 0.05 + 0.04);
                        propValue *= propGrowth;
                        propertyValues.push(propValue);

                        // Random growth between 3-7% for city average (future prediction)
                        const cityGrowth = 1 + (Math.random() * 0.04 + 0.03);
                        cityValue *= cityGrowth;
                        cityAverages.push(cityValue);
                    }

                    const trendsChart = new Chart(trendsChartCtx, {
                        type: 'line',
                        data: {
                            labels: years,
                            datasets: [
                                {
                                    label: 'Neighborhood Property Values',
                                    data: propertyValues,
                                    borderColor: 'rgba(46, 204, 113, 1)',
                                    backgroundColor: 'rgba(46, 204, 113, 0.1)',
                                    fill: true,
                                    tension: 0.4,
                                    pointBackgroundColor: 'rgba(46, 204, 113, 1)',
                                    pointBorderColor: '#fff',
                                    pointRadius: 5,
                                    pointHoverRadius: 8,
                                    borderWidth: 3
                                },
                                {
                                    label: 'City Average',
                                    data: cityAverages,
                                    borderColor: 'rgba(52, 152, 219, 1)',
                                    backgroundColor: 'rgba(52, 152, 219, 0.1)',
                                    fill: true,
                                    tension: 0.4,
                                    pointBackgroundColor: 'rgba(52, 152, 219, 1)',
                                    pointBorderColor: '#fff',
                                    pointRadius: 5,
                                    pointHoverRadius: 8,
                                    borderWidth: 3
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: false,
                                    title: {
                                        display: true,
                                        text: 'Property Value ($)'
                                    },
                                    ticks: {
                                        callback: function (value) {
                                            return '$' + value.toLocaleString();
                                        }
                                    }
                                },
                                x: {
                                    title: {
                                        display: true,
                                        text: 'Year'
                                    }
                                }
                            },
                            plugins: {
                                title: {
                                    display: true,
                                    text: 'Property Value Trends & Forecast',
                                    font: {
                                        size: 16
                                    }
                                },
                                legend: {
                                    position: 'bottom'
                                },
                                tooltip: {
                                    mode: 'index',
                                    intersect: false,
                                    callbacks: {
                                        label: function (context) {
                                            return context.dataset.label + ': $' + context.raw.toLocaleString();
                                        }
                                    }
                                }
                            }
                        }
                    });

                    // Add hover effects to property cards
                    const propertyCards = document.querySelectorAll('.property-card');
                    propertyCards.forEach(card => {
                        card.addEventListener('mouseenter', function () {
                            this.style.transform = 'translateY(-10px)';
                            this.style.boxShadow = '0 10px 20px rgba(0, 0, 0, 0.1)';
                        });

                        card.addEventListener('mouseleave', function () {
                            this.style.transform = 'translateY(-5px)';
                            this.style.boxShadow = '0 2px 10px rgba(0, 0, 0, 0.05)';
                        });
                    });

                    // Add click functionality to CTA buttons
                    const ctaButtons = document.querySelectorAll('.cta-button');
                    ctaButtons.forEach(button => {
                        button.addEventListener('click', function (e) {
                            e.preventDefault();
                            if (this.id === 'requestAnalysisBtn') {
                                alert('This would generate and send a detailed PDF market analysis for this neighborhood.');
                            } else {
                                alert('This feature would open a detailed map view in a production environment.');
                            }
                        });
                    });

                    // Set prediction bar width from data attribute
                    const predictionFill = document.querySelector('.prediction-fill');
                    if (predictionFill) {
                        const width = predictionFill.getAttribute('data-width');
                        predictionFill.style.width = width + '%';
                    }
                });
            </script>
</body>

</html>
