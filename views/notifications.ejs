<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <script src="https://kit.fontawesome.com/21a1c82f31.js" crossorigin="anonymous"></script>

<%- include('partials/header') %>

<main>
    <section class="section notification-section bg-light py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card shadow">
                        <div class="card-header bg-primary d-flex justify-content-between align-items-center">
                            <h3 class="text-white mb-0">Notifications & Alerts</h3>
                            <div class="notification-actions">
                                <% if (unreadCount > 0) { %>
                                    <form action="/notifications/mark-all-read" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-light">
                                            <i class="fa fa-check-double"></i> Mark All as Read
                                        </button>
                                    </form>
                                <% } %>
                                <div class="btn-group ml-2">
                                    <a href="/notifications<%= unreadOnly ? '' : '?unreadOnly=true' %>" class="btn btn-sm <%= unreadOnly ? 'btn-light' : 'btn-outline-light' %>">
                                        <i class="fa fa-bell"></i> <%= unreadOnly ? 'All Notifications' : 'Unread Only' %>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="notification-filter mb-4">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <h5 class="mb-0">
                                            <span class="badge badge-pill badge-primary"><%= unreadCount %></span> Unread notifications
                                        </h5>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="input-group">
                                            <select id="notification-type-filter" class="form-control">
                                                <option value="all" selected>All Notifications</option>
                                                <option value="rent_due">Rent Alerts</option>
                                                <option value="emi_due">EMI Alerts</option>
                                                <option value="property">Property Updates</option>
                                                <option value="loan">Loan Status</option>
                                                <option value="visit">Visit Updates</option>
                                                <option value="message">Messages</option>
                                                <option value="system">System Notifications</option>
                                            </select>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="notification-list">
                                <% if (notifications && notifications.length > 0) { %>
                                    <div class="list-group">
                                        <% notifications.forEach(notification => { %>
                                            <div class="list-group-item notification-item <%= notification.isRead ? '' : 'unread' %> priority-<%= notification.priority %> type-<%= notification.type.includes('_') ? notification.type.split('_')[0] : notification.type %>"
                                                 data-notification-id="<%= notification._id %>"
                                                 data-notification-type="<%= notification.type %>">
                                                
                                                <div class="d-flex align-items-start">
                                                    <div class="notification-icon mr-3">
                                                        <% if (notification.type.includes('rent')) { %>
                                                            <i class="fas fa-home fa-2x text-warning"></i>
                                                        <% } else if (notification.type.includes('emi')) { %>
                                                            <i class="fas fa-money-bill-wave fa-2x text-success"></i>
                                                        <% } else if (notification.type.includes('property')) { %>
                                                            <i class="fas fa-building fa-2x text-primary"></i>
                                                        <% } else if (notification.type.includes('loan')) { %>
                                                            <i class="fas fa-hand-holding-usd fa-2x text-info"></i>
                                                        <% } else if (notification.type.includes('visit')) { %>
                                                            <i class="fas fa-calendar-check fa-2x text-secondary"></i>
                                                        <% } else if (notification.type.includes('message')) { %>
                                                            <i class="fas fa-envelope fa-2x text-danger"></i>
                                                        <% } else { %>
                                                            <i class="fas fa-bell fa-2x text-dark"></i>
                                                        <% } %>
                                                    </div>
                                                    <div class="notification-content flex-grow-1">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <h5 class="mb-0 notification-title">
                                                                <%= notification.title %>
                                                                <% if (!notification.isRead) { %>
                                                                    <span class="badge badge-pill badge-danger ml-2">New</span>
                                                                <% } %>
                                                                <% if (notification.priority === 'high') { %>
                                                                    <span class="badge badge-pill badge-warning ml-2">Important</span>
                                                                <% } %>
                                                            </h5>
                                                            <small class="text-muted notification-time">
                                                                <%= new Date(notification.createdAt).toLocaleString() %>
                                                            </small>
                                                        </div>
                                                        <p class="mb-2 notification-message"><%= notification.message %></p>
                                                        <div class="notification-actions d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <% if (notification.link) { %>
                                                                    <a href="<%= notification.link %>" class="btn btn-sm btn-outline-primary">
                                                                        <i class="fas fa-external-link-alt"></i> View Details
                                                                    </a>
                                                                <% } %>
                                                            </div>
                                                            <div class="btn-group">
                                                                <% if (!notification.isRead) { %>
                                                                    <form action="/notifications/<%= notification._id %>/mark-read" method="POST" class="d-inline mark-read-form">
                                                                        <button type="submit" class="btn btn-sm btn-outline-success mark-read-btn">
                                                                            <i class="fas fa-check"></i> Mark as Read
                                                                        </button>
                                                                    </form>
                                                                <% } %>
                                                                <button type="button" class="btn btn-sm btn-outline-danger delete-notification-btn" data-id="<%= notification._id %>">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                    
                                    <!-- Pagination -->
                                    <% if (pagination.totalPages > 1) { %>
                                        <div class="pagination-container mt-4">
                                            <nav aria-label="Notification pagination">
                                                <ul class="pagination justify-content-center">
                                                    <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                                                        <a class="page-link" href="/notifications?page=<%= pagination.page - 1 %><%= unreadOnly ? '&unreadOnly=true' : '' %>">Previous</a>
                                                    </li>
                                                    
                                                    <% for(let i = Math.max(1, pagination.page - 2); i <= Math.min(pagination.totalPages, pagination.page + 2); i++) { %>
                                                        <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                                                            <a class="page-link" href="/notifications?page=<%= i %><%= unreadOnly ? '&unreadOnly=true' : '' %>"><%= i %></a>
                                                        </li>
                                                    <% } %>
                                                    
                                                    <li class="page-item <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>">
                                                        <a class="page-link" href="/notifications?page=<%= pagination.page + 1 %><%= unreadOnly ? '&unreadOnly=true' : '' %>">Next</a>
                                                    </li>
                                                </ul>
                                            </nav>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <div class="alert alert-info text-center py-5">
                                        <i class="fas fa-bell-slash fa-3x mb-3"></i>
                                        <h4>No notifications found</h4>
                                        <p>You don't have any <%= unreadOnly ? 'unread' : '' %> notifications at the moment.</p>
                                        <% if (unreadOnly) { %>
                                            <a href="/notifications" class="btn btn-primary mt-2">View All Notifications</a>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Filter notifications by type
        const typeFilter = document.getElementById('notification-type-filter');
        const notificationItems = document.querySelectorAll('.notification-item');
        
        typeFilter.addEventListener('change', function() {
            const selectedType = this.value;
            
            notificationItems.forEach(item => {
                const notificationType = item.dataset.notificationType;
                
                if (selectedType === 'all') {
                    item.style.display = 'block';
                } else if (selectedType === 'rent_due' && notificationType.includes('rent')) {
                    item.style.display = 'block';
                } else if (selectedType === 'emi_due' && notificationType.includes('emi')) {
                    item.style.display = 'block';
                } else if (selectedType === 'property' && notificationType.includes('property')) {
                    item.style.display = 'block';
                } else if (selectedType === 'loan' && notificationType.includes('loan')) {
                    item.style.display = 'block';
                } else if (selectedType === 'visit' && notificationType.includes('visit')) {
                    item.style.display = 'block';
                } else if (selectedType === 'message' && notificationType.includes('message')) {
                    item.style.display = 'block';
                } else if (selectedType === 'system' && notificationType === 'system') {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        });
        
        // Handle mark as read AJAX
        const markReadForms = document.querySelectorAll('.mark-read-form');
        markReadForms.forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const formUrl = this.getAttribute('action');
                const notificationItem = this.closest('.notification-item');
                const markReadBtn = this.querySelector('.mark-read-btn');
                
                // Disable button while processing
                markReadBtn.disabled = true;
                
                fetch(formUrl, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Remove unread class and update UI
                        notificationItem.classList.remove('unread');
                        
                        // Remove the "New" badge
                        const newBadge = notificationItem.querySelector('.badge-danger');
                        if (newBadge) newBadge.remove();
                        
                        // Remove the mark as read button
                        this.remove();
                        
                        // Update unread count in header (if exists)
                        const unreadCountBadge = document.querySelector('.notification-count-badge');
                        if (unreadCountBadge) {
                            const currentCount = parseInt(unreadCountBadge.textContent);
                            if (currentCount > 0) {
                                unreadCountBadge.textContent = currentCount - 1;
                            }
                        }
                    }
                })
                .catch(error => {
                    console.error('Error marking notification as read:', error);
                    // Re-enable button
                    markReadBtn.disabled = false;
                });
            });
        });
        
        // Handle delete notification
        const deleteButtons = document.querySelectorAll('.delete-notification-btn');
        deleteButtons.forEach(button => {
            button.addEventListener('click', function() {
                if (confirm('Are you sure you want to delete this notification?')) {
                    const notificationId = this.dataset.id;
                    const notificationItem = this.closest('.notification-item');
                    
                    fetch(`/notifications/${notificationId}`, {
                        method: 'DELETE',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Remove the notification from DOM with animation
                            notificationItem.style.transition = 'opacity 0.3s ease-out';
                            notificationItem.style.opacity = '0';
                            setTimeout(() => {
                                notificationItem.remove();
                                
                                // If no notifications left, show empty state
                                if (document.querySelectorAll('.notification-item').length === 0) {
                                    const notificationList = document.querySelector('.notification-list');
                                    notificationList.innerHTML = `
                                        <div class="alert alert-info text-center py-5">
                                            <i class="fas fa-bell-slash fa-3x mb-3"></i>
                                            <h4>No notifications found</h4>
                                            <p>You don't have any notifications at the moment.</p>
                                        </div>
                                    `;
                                }
                            }, 300);
                        }
                    })
                    .catch(error => {
                        console.error('Error deleting notification:', error);
                    });
                }
            });
        });
    });
</script>

<style>
    .notification-section {
        padding: 60px 0;
        background-color: #f8f9fa;
    }
    
    .card.shadow {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
        overflow: hidden;
    }
    
    .card-header {
        background: linear-gradient(135deg, #ff8a00, #ff5100) !important;
        border-bottom: none;
        padding: 1.25rem 1.5rem;
    }
    
    .notification-item {
        border-left: 4px solid transparent;
        transition: all 0.3s ease;
        margin-bottom: 15px;
        border-radius: 8px;
        padding: 1.25rem;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
    }
    
    .notification-item.unread {
        background-color: rgba(255, 138, 0, 0.05);
        border-left-color: #ff8a00;
    }
    
    .notification-item.priority-high {
        border-left-color: #ff5100;
        background-color: rgba(255, 81, 0, 0.03);
    }
    
    .notification-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        background-color: rgba(255, 138, 0, 0.03);
    }
    
    .notification-icon {
        width: 60px;
        height: 60px;
        text-align: center;
        background-color: rgba(255, 138, 0, 0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1.25rem !important;
    }
    
    .notification-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #343a40;
    }
    
    .notification-message {
        color: #555;
        line-height: 1.5;
        margin-bottom: 1rem;
    }
    
    .notification-time {
        font-size: 0.85rem;
        color: #888;
        font-weight: 500;
    }
    
    /* Priority styles */
    .priority-high .notification-title {
        color: #ff5100;
    }
    
    /* Notification types */
    .type-rent .notification-icon {
        background-color: rgba(255, 126, 20, 0.15);
    }
    
    .type-rent .notification-icon i {
        color: #ff7e14;
    }
    
    .type-emi .notification-icon {
        background-color: rgba(32, 201, 151, 0.15);
    }
    
    .type-emi .notification-icon i {
        color: #20c997;
    }
    
    .type-property .notification-icon {
        background-color: rgba(13, 110, 253, 0.15);
    }
    
    .type-property .notification-icon i {
        color: #0d6efd;
    }
    
    .type-loan .notification-icon {
        background-color: rgba(111, 66, 193, 0.15);
    }
    
    .type-loan .notification-icon i {
        color: #6f42c1;
    }
    
    .type-visit .notification-icon {
        background-color: rgba(108, 117, 125, 0.15);
    }
    
    .type-visit .notification-icon i {
        color: #6c757d;
    }
    
    .type-message .notification-icon {
        background-color: rgba(220, 53, 69, 0.15);
    }
    
    .type-message .notification-icon i {
        color: #dc3545;
    }
    
    /* Button styles */
    .btn-outline-primary {
        color: #ff8a00;
        border-color: #ff8a00;
    }
    
    .btn-outline-primary:hover {
        background-color: #ff8a00;
        border-color: #ff8a00;
        color: white;
    }
    
    .btn-outline-success {
        color: #28a745;
        border-color: #28a745;
    }
    
    .btn-outline-danger {
        color: #dc3545;
        border-color: #dc3545;
    }
    
    .btn-primary {
        background-color: #ff8a00;
        border-color: #ff8a00;
    }
    
    .btn-primary:hover {
        background-color: #ff5100;
        border-color: #ff5100;
    }
    
    .btn-light {
        background-color: rgba(255, 255, 255, 0.9);
        border-color: rgba(255, 255, 255, 0.9);
    }
    
    .badge-danger {
        background-color: #ff5100;
    }
    
    .badge-warning {
        background-color: #ff8a00;
        color: white;
    }
    
    /* .badge-primary {
        background-color: #ff8a00;
    } */
    
    /* Filter section */
    .notification-filter {
        background-color: rgba(255, 138, 0, 0.03);
        padding: 1rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
    }
    
    .form-control {
        border-radius: 8px 0 0 8px;
        border-color: #ced4da;
    }
    
    .input-group-text {
        background-color: #ff8a00;
        color: white;
        border-color: #ff8a00;
        border-radius: 0 8px 8px 0;
    }
    
    /* Pagination */
    .pagination .page-link {
        color: #ff8a00;
        border-color: #dee2e6;
        margin: 0 3px;
        border-radius: 6px;
    }
    
    .pagination .page-item.active .page-link {
        background-color: #ff8a00;
        border-color: #ff8a00;
        color: white;
    }
    
    .pagination .page-item.disabled .page-link {
        color: #6c757d;
    }
    
    /* Empty state */
    .alert-info {
        background-color: rgba(255, 138, 0, 0.05);
        border-color: rgba(255, 138, 0, 0.2);
        color: #ff5100;
        border-radius: 12px;
    }
    
    /* Animation effects */
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .notification-item {
        animation: fadeIn 0.3s ease-out forwards;
    }
    
    /* Container spacing */
    .container {
        padding: 0 1.5rem;
    }
    
    /* Notification Actions */
    .notification-actions .btn-group {
        margin-left: 0.5rem;
    }
    
    .notification-actions .btn {
        border-radius: 6px;
        padding: 0.375rem 0.75rem;
        transition: all 0.2s;
    }
</style>

<%- include('partials/footer') %> 