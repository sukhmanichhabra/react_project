<body>

    <%- include('./partials/navbar') %>

        <style>
            /* Adjust hero section to account for navbar */
            .hero {
                padding-top: 120px;
                /* Add padding to account for fixed navbar */
                margin-top: 0 !important;
                /* Override the negative margin in the original CSS */
                position: relative;
                overflow: hidden;
                background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            }

            /* Make sure navbar is visible on all pages */
            .navbar {
                background-color: white;
                box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
            }

            /* Ensure proper spacing for the first section */
            main {
                margin-top: 0;
            }

            /* Enhanced Hero Section Styles */
            .hero::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23ff6634' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
                opacity: 0.5;
                z-index: 0;
            }

            .hero .container {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 30px;
                padding-block: 60px;
            }

            .hero-content {
                flex: 1;
                max-width: 600px;
                margin-bottom: 0;
                animation: fadeInUp 0.8s ease-out forwards;
            }

            .hero-subtitle {
                background: rgba(255, 102, 52, 0.1);
                border-radius: 50px;
                padding: 8px 16px;
                display: inline-flex;
                align-items: center;
                margin-bottom: 25px;
                border-left: none;
                animation: slideInRight 0.6s ease-out forwards;
            }

            .hero-subtitle ion-icon {
                color: var(--orange-soda);
                margin-right: 8px;
                font-size: 18px;
            }

            .hero-subtitle span {
                color: var(--orange-soda);
                font-weight: 600;
                font-size: 14px;
                letter-spacing: 0.5px;
            }

            .hero-title {
                font-size: 3.5rem;
                line-height: 1.2;
                margin-bottom: 25px;
                color: #2d3748;
                font-weight: 700;
                position: relative;
            }

            .hero-title::after {
                content: "";
                position: absolute;
                bottom: -15px;
                left: 0;
                width: 80px;
                height: 4px;
                background: var(--orange-soda);
                border-radius: 2px;
            }

            .hero-text {
                color: #4a5568;
                font-size: 1.1rem;
                line-height: 1.8;
                margin-bottom: 35px;
                border-left: none;
                padding-left: 0;
            }

            .hero-stats {
                display: flex;
                gap: 30px;
                margin-top: 40px;
                animation: fadeInUp 1s ease-out 0.3s forwards;
                opacity: 0;
            }

            .stat-item {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
            }

            .stat-number {
                font-size: 2rem;
                font-weight: 700;
                color: var(--orange-soda);
                margin-bottom: 5px;
            }

            .stat-text {
                font-size: 0.9rem;
                color: #4a5568;
            }

            .hero-buttons {
                display: flex;
                gap: 15px;
                margin-top: 30px;
            }

            .btn {
                padding: 15px 30px;
                border-radius: 50px;
                font-weight: 600;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
                z-index: 1;
            }

            .btn-primary {
                background: var(--orange-soda);
                color: white;
                border: none;
            }

            .btn-secondary {
                background: transparent;
                color: #2d3748;
                border: 2px solid #e2e8f0;
            }

            .btn-primary:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(255, 102, 52, 0.3);
            }

            .btn-secondary:hover {
                background: #f8f9fa;
                border-color: #cbd5e0;
                transform: translateY(-3px);
            }

            .hero-banner {
                flex: 1;
                position: relative;
                animation: floatAnimation 6s ease-in-out infinite;
            }

            .hero-banner img {
                max-width: 100%;
                border-radius: 20px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
                position: relative;
                z-index: 1;
            }

            .shape-1 {
                position: absolute;
                top: -30px;
                right: -30px;
                width: 150px;
                height: 150px;
                background: rgba(255, 102, 52, 0.1);
                border-radius: 50%;
                z-index: 0;
                animation: pulse 4s infinite;
            }

            .shape-2 {
                position: absolute;
                bottom: -20px;
                left: -20px;
                width: 100px;
                height: 100px;
                background: rgba(66, 153, 225, 0.1);
                border-radius: 50%;
                z-index: 0;
                animation: pulse 4s infinite 1s;
            }

            .trusted-by {
                margin-top: 60px;
                text-align: center;
                opacity: 0;
                animation: fadeInUp 1s ease-out 0.6s forwards;
            }

            .trusted-by h4 {
                font-size: 0.9rem;
                color: #718096;
                margin-bottom: 20px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .partner-logos {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 40px;
                flex-wrap: wrap;
            }

            .partner-logo {
                opacity: 0.7;
                transition: opacity 0.3s ease;
                height: 30px;
                filter: grayscale(100%);
            }

            .partner-logo:hover {
                opacity: 1;
                filter: grayscale(0%);
            }

            /* Animations */
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(-30px);
                }

                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @keyframes floatAnimation {

                0%,
                100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-15px);
                }
            }

            @keyframes pulse {

                0%,
                100% {
                    transform: scale(1);
                    opacity: 0.5;
                }

                50% {
                    transform: scale(1.1);
                    opacity: 0.8;
                }
            }

            /* Responsive adjustments */
            @media (max-width: 992px) {
                .hero .container {
                    flex-direction: column;
                    text-align: center;
                    padding-block: 40px;
                }

                .hero-content {
                    max-width: 100%;
                }

                .hero-title::after {
                    left: 50%;
                    transform: translateX(-50%);
                }

                .hero-stats {
                    justify-content: center;
                }

                .stat-item {
                    align-items: center;
                }

                .hero-buttons {
                    justify-content: center;
                }

                .hero-banner {
                    margin-top: 40px;
                    max-width: 80%;
                }
            }

            @media (max-width: 768px) {
                .hero-title {
                    font-size: 2.5rem;
                }

                .hero-stats {
                    flex-wrap: wrap;
                    gap: 20px;
                }

                .hero-banner {
                    max-width: 100%;
                }
            }
        </style>

